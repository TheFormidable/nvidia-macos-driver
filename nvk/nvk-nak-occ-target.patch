+/// nvk-nak-occ-target (3.0.15): a graphics stage below this many warps per SM (of 48 on SM120) is tried again under
+/// tighter register ceilings. The heavy fragment shaders of a shader pack sit at 16 to 28.
+const NAK_OCC_TRY_BELOW: u32 = 32;
+/// nvk-nak-occ-target: a build with more warps is kept only if it has at most this many percent more instructions
+/// (spill and fill instructions included) than the build without a ceiling.
+const NAK_OCC_MAX_GROWTH_PCT: u64 = 5;
+
+/// nvk-nak-occ-target: on unless NAK_OCC_TARGET=0 (read once per process).
+fn nak_occ_target_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| env::var("NAK_OCC_TARGET").map_or(true, |v| v != "0"))
+}
+
+/// nvk-nak-occ-target: never in WindowServer. It has no shell environment and NAK does not read nvrm610.conf, so
+/// NAK_OCC_TARGET=0 could not reach it: there the compiler stays as it was in 3.0.14 (read once per process).
+fn nak_occ_in_windowserver() -> bool {
+    static WS: OnceLock<bool> = OnceLock::new();
+    *WS.get_or_init(|| {
+        env::current_exe().map_or(false, |p| p.file_name().map_or(false, |n| n == "WindowServer"))
+    })
+}
+
+/// nvk-nak-occ-target: the stages it applies to. Compute, kernels, task and mesh shaders keep their own rules
+/// (the prepass pick above, the RAW cap).
+fn nak_occ_stage(stage: mesa_shader_stage) -> bool {
+    stage == MESA_SHADER_VERTEX
+        || stage == MESA_SHADER_TESS_CTRL
+        || stage == MESA_SHADER_TESS_EVAL
+        || stage == MESA_SHADER_GEOMETRY
+        || stage == MESA_SHADER_FRAGMENT
+}
+
+/// nvk-nak-occ-target: more warps only help a shader that waits on memory: one with a texture or global access.
+fn nak_occ_hides_latency(s: &Shader) -> bool {
+    if s.info.uses_global_mem {
+        return true;
+    }
+    let mut tex = false;
+    s.for_each_instr(&mut |instr| {
+        tex |= matches!(
+            &instr.op,
+            Op::Tex(_) | Op::Tld(_) | Op::Tld4(_) | Op::Txd(_) | Op::Tmml(_)
+        );
+    });
+    tex
+}
+
+/// nvk-nak-occ-target: the largest physical register count (a multiple of 8, hardware-reserved registers included)
+/// that gives more than `warps` warps per SM, or None when no such count leaves room for NAK's allocator (it needs
+/// 18 above the reserved ones; 32 is asked here) or the SM is already at its most warps.
+fn nak_occ_ceiling(sm: &ShaderModelInfo, warps: u32) -> Option<u32> {
+    let floor = sm.hw_reserved_gprs() + 32;
+    let mut g = 256u32;
+    while g >= floor {
+        if max_warps_per_sm(sm, g) > warps {
+            return Some(g);
+        }
+        g -= 8;
+    }
+    None
+}
+
+// nvk-nak-occ-target: the register ceiling of the build being tried (0 = none), read in the build closure.
+thread_local! {
+    static NAK_OCC_CEILING: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+}
+struct NakOccCeilingGuard(u32);
+impl NakOccCeilingGuard {
+    fn new(ceiling: u32) -> Self {
+        Self(NAK_OCC_CEILING.with(|c| c.replace(ceiling)))
+    }
+}
+impl Drop for NakOccCeilingGuard {
+    fn drop(&mut self) {
+        NAK_OCC_CEILING.with(|c| c.set(self.0));
+    }
+}
+
