+static int nvrm_local_map_mode_value;
+static util_once_flag nvrm_local_map_mode_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+nvrm_local_map_mode_read(const void *data)
+{
+   const struct nvkmd_nvrm_pdev *pdev = data;
+   const char *e = nvmtl_cfg_getenv("NVK_LOCAL_MAP_SYSMEM");
+   const bool set = e != NULL, zero = set && e[0] == '0';
+   const char *b = nvmtl_cfg_getenv("NVK_BAR_VRAM");
+   const bool bar_vram_off = b != NULL && b[0] == '0';
+   const char *pn = getprogname();
+   const bool ws = pn != NULL && strcmp(pn, "WindowServer") == 0;
+   const bool bar_covers_vram = pdev->base.dev_info.bar_size_B >= pdev->base.dev_info.vram_size_B;
+   const int m = nvrm_local_map_rule(set ? (zero ? "0" : "1") : NULL, bar_covers_vram, ws, bar_vram_off);
+   nvrm_local_map_mode_value = m;
+   if (nvkmd_nvrm_diag_on()) fprintf(stderr, "nvrm: LOCAL+mapped memory -> %s (BAR1 %llu MB, VRAM %llu MB, %s)\n",
+           m == NVRM_LOCAL_MAP_VRAM_ALL ? "VRAM through BAR1" :
+           m == NVRM_LOCAL_MAP_VRAM_PRIVATE ? "VRAM through BAR1 unless shared" : "system RAM",
+           (unsigned long long)(pdev->base.dev_info.bar_size_B >> 20),
+           (unsigned long long)(pdev->base.dev_info.vram_size_B >> 20),
+           set ? (zero ? "NVK_LOCAL_MAP_SYSMEM=0" : "NVK_LOCAL_MAP_SYSMEM set") :
+           ws ? "default, WindowServer" : bar_vram_off ? "default, NVK_BAR_VRAM=0" : "default");
+}
