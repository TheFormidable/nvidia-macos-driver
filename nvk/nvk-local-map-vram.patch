+/* The rule alone (tools/test_nvk_local_map.py compiles it): e is NVK_LOCAL_MAP_SYSMEM's value or NULL when unset. */
+static int
+nvrm_local_map_rule(const char *e, bool bar_covers_vram, bool window_server, bool bar_vram_off)
+{
+   if (!bar_covers_vram)
+      return NVRM_LOCAL_MAP_SYSMEM;
+   if (e != NULL)
+      return e[0] == '0' ? NVRM_LOCAL_MAP_VRAM_ALL : NVRM_LOCAL_MAP_SYSMEM;
+   return (window_server || bar_vram_off) ? NVRM_LOCAL_MAP_SYSMEM : NVRM_LOCAL_MAP_VRAM_PRIVATE;
+}
