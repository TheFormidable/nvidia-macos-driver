    /* VRAM, generic pte kind: the plugin places a LINEAR image at the surface's bytesPerRow in it */
-   return create_mem_or_close_bo(dev, log_obj, NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM | NVKMD_MEM_SHARED, h, e.size, NVKMD_VA_GART, 0,
-                                 _dev->pdev->bind_align_B, mem_out);
+   const VkResult result = create_mem_or_close_bo(dev, log_obj, NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM | NVKMD_MEM_SHARED, h, e.size,
+                                                  NVKMD_VA_GART, 0, _dev->pdev->bind_align_B, mem_out);
+   /* The block that was shared: the kernel's name for it (3.0.7), 0 from a kernel that copies the word back as sent.
+    * Set only here, once the import exists, so a caller never reads the name of an import it did not get. */
+   if (result == VK_SUCCESS)
+      nvrm_import_cookie = e.pad;
+   return result;
 }
 
