+/* An import kept for longer than one frame (the Zink frontend's presentation queue). nvmtl_nvk_import_cookie: the
+ * kernel's name for the block the last vkAllocateMemory import on this thread received, read right after that call
+ * returns VK_SUCCESS; 0 = not told (a kernel before 3.0.7, or the import failed): import again for every frame.
+ * nvmtl_nvk_surface_dirty_at: the mark of nvmtl_nvk_surface_dirty, taken only if the surface still has that block;
+ * 0x8000000A (NVRM_SS_MOVED) = it has another one or none, nothing was marked, and the import has to be dropped. */
+uint32_t nvmtl_nvk_import_cookie(void);   /* exported: the Zink frontend's dlsym */
+uint32_t nvkmd_nvrm_surface_dirty_at(struct nvkmd_dev *dev, uint32_t surfaceID, uint32_t plane, uint32_t cookie);
+uint32_t nvmtl_nvk_surface_dirty_at(VkDevice device, uint32_t surfaceID, uint32_t plane, uint32_t cookie);   /* exported: the Zink frontend's dlsym */
