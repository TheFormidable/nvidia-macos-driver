diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c
@@ -154,6 +154,27 @@
    return nvRmApiSurfShare(&rm, NVRM_ESC_SURF_DIRTY, &e);
 }
 
+/* A caller that keeps an import for longer than one frame names the block it imported (nvkmd.h). The kernel's answer
+ * to the last import that succeeded on this thread; 0 after one that failed, and from a kernel that does not tell. */
+static __thread uint32_t nvrm_import_cookie;
+__attribute__((visibility("default"))) uint32_t   /* exported: the Zink frontend's dlsym */
+nvmtl_nvk_import_cookie(void)
+{
+   return nvrm_import_cookie;
+}
+
+/* nvkmd_nvrm_surface_dirty for a kept import: the mark is taken only if the surface still has the block `cookie` names. */
+uint32_t
+nvkmd_nvrm_surface_dirty_at(struct nvkmd_dev *_dev, uint32_t surfaceID, uint32_t plane, uint32_t cookie)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   struct NVRMSurfShareEsc e = { .surfaceID = surfaceID, .plane = plane, .hClient = pdev->hClient, .pad = cookie };
+   return nvRmApiSurfShare(&rm, NVRM_ESC_SURF_DIRTY, &e);
+}
+
