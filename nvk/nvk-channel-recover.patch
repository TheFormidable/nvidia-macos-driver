+/* ── the ring model ── */
+struct model {
+   struct nvrm_rec_ring r;
+   uint64_t S, gpGet;
+   unsigned cur;
+   uint32_t fifo[2 * NVRM_REC_FIFO];
+   uint32_t unflushed;   /* entries written after the last doorbell */
+   uint64_t total;       /* entries ever written */
+};
+
+#define TAG_UNFLUSHED 0x80000000u
+
+static void
+model_complete_to(struct model *m, uint64_t seq)
+{
+   if (seq <= m->S)
+      return;
+   m->S = seq;
+   for (unsigned i = 0; i < NVRM_REC_RING; i++)
+      if (m->r.slotSeq[i] == seq)
+         m->gpGet = m->r.slotPut[i];
+}
+
+static void
+model_entry(struct model *m, uint32_t dw0, uint32_t dw1)
+{
+   while ((m->r.gpPut + 1) % NVRM_REC_FIFO == m->gpGet) {
+      /* full: the oldest flush in flight completes (the reserve's wait) */
+      uint64_t oldest = 0;
+      for (unsigned i = 0; i < NVRM_REC_RING; i++)
+         if (m->r.slotSeq[i] > m->S && (oldest == 0 || m->r.slotSeq[i] < oldest))
+            oldest = m->r.slotSeq[i];
+      model_complete_to(m, oldest);
+   }
+   m->fifo[2 * m->r.gpPut] = dw0;
+   m->fifo[2 * m->r.gpPut + 1] = dw1;
+   m->r.gpPut = (m->r.gpPut + 1) % NVRM_REC_FIFO;
+   m->total++;
+}
+
+static void
+model_flush(struct model *m, uint32_t entries)
+{
+   const uint64_t n = m->r.wSeq + 1;
+   for (uint32_t k = 0; k < entries; k++)
+      model_entry(m, (uint32_t)n, k);
+   m->r.slotBeg[m->cur] = m->r.subPut;   /* the flush owns everything since the last doorbell */
+   m->r.wSeq = n;
+   m->r.slotSeq[m->cur] = n;
+   m->r.slotPut[m->cur] = m->r.gpPut;
+   m->r.subPut = m->r.gpPut;
+   const unsigned next = (m->cur + 1) % NVRM_REC_RING;
+   if (m->r.slotSeq[next] != 0 && m->S < m->r.slotSeq[next])
+      model_complete_to(m, m->r.slotSeq[next]);   /* the slot wait */
+   m->cur = next;
+}
+
+static void
+model_build(struct model *m, unsigned flushes, uint32_t maxEntries, bool unflushed)
+{
+   memset(m, 0, sizeof(*m));
+   for (unsigned f = 0; f < flushes; f++) {
+      model_flush(m, 1 + rnd(maxEntries));
+      if (rnd(4) == 0)   /* the GPU makes progress now and then */
+         model_complete_to(m, m->S + rnd((uint32_t)(m->r.wSeq - m->S) + 1));
+   }
+   m->unflushed = unflushed ? 1 + rnd(12) : 0;
+   for (uint32_t k = 0; k < m->unflushed; k++)
+      model_entry(m, TAG_UNFLUSHED | k, k);
+}
+
+/* Checks one plan and fill against the model; returns NULL when right, else what is wrong. */
+static const char *
+check_fill(const struct model *m, const struct nvrm_rec_plan *p, const uint32_t *nf, const struct nvrm_rec_ring *out,
+           const uint32_t pro[2])
+{
+   uint32_t at = 0;
+   if (p->prologue) {
+      if (nf[0] != pro[0] || nf[1] != pro[1])
+         return "the prologue entry is not first";
+      at = 1;
+   }
+   for (uint64_t n = p->keepLo; n <= p->keepHi; n++) {
+      unsigned i = NVRM_REC_RING;
+      for (unsigned j = 0; j < NVRM_REC_RING; j++)
+         if (m->r.slotSeq[j] == n)
+            i = j;
+      if (i == NVRM_REC_RING)
+         return "a kept flush has no record in the model";
+      if (out->slotSeq[i] != n || out->slotBeg[i] != at)
+         return "a kept flush's record is not rebased to where its entries went";
+      for (uint64_t e = m->r.slotBeg[i]; e != m->r.slotPut[i]; e = (e + 1) % NVRM_REC_FIFO) {
+         if (nf[2 * at] != m->fifo[2 * e] || nf[2 * at + 1] != m->fifo[2 * e + 1] || nf[2 * at] != (uint32_t)n)
+            return "a kept flush's entries are not copied in order and unchanged";
+         at++;
+      }
+      if (out->slotPut[i] != at)
+         return "a kept flush's end is not rebased";
+   }
+   if (out->subPut != at || p->newSubPut != at)
+      return "the new GPPut is not the end of the kept flushes";
+   for (uint32_t k = 0; k < m->unflushed; k++, at++)
+      if (nf[2 * at] != (TAG_UNFLUSHED | k))
+         return "the unflushed entries do not follow the kept flushes in order";
+   if (out->gpPut != at || p->newGpPut != at)
+      return "the new put is not after the unflushed entries";
+   for (uint32_t e = 0; e < at; e++) {
+      const uint32_t tag = nf[2 * e];
+      if (!(tag & TAG_UNFLUSHED) && !(p->prologue && e == 0) && tag >= p->dropLo && tag <= p->dropHi)
+         return "a dropped flush's entry was carried";
+   }
+   for (unsigned i = 0; i < NVRM_REC_RING; i++) {
+      const uint64_t n = m->r.slotSeq[i];
+      const bool kept = n != 0 && n >= p->keepLo && n <= p->keepHi;
+      if (!kept && (out->slotSeq[i] | out->slotBeg[i] | out->slotPut[i]) != 0)
+         return "a ring slot that is not replayed is not zero";
+   }
+   if (out->wSeq != m->r.wSeq)
+      return "the last flushed number changed";
+   if (p->dropLo <= p->dropHi && (p->dropLo != p->S + 1 || p->dropHi + 1 != (p->keepLo <= p->keepHi ? p->keepLo : p->F + 1)))
+      return "the dropped range is not the flushes between the semaphore and the first replayed one";
+   return NULL;
+}
+
+static uint32_t newFifo[2 * NVRM_REC_FIFO];
+
+static void
+test_plan_fill(void)
+{
+   static const uint32_t pro[2] = { 0xA5A5A5A5u, 0x5A5A5A5Au };
+   static struct model m;
+   unsigned rounds = 0, plans = 0, wraps = 0;
+   const char *first_bad = NULL;
+   bool level_ranges_ok = true, monotonic = true;
+   for (unsigned t = 0; t < 400; t++) {
+      const uint32_t maxE = t % 3 == 0 ? 40 : t % 3 == 1 ? 8 : 400;   /* the third shape wraps the GPFIFO often */
+      model_build(&m, 70 + rnd(300), maxE, t % 2 == 0);
+      if (m.total > NVRM_REC_FIFO)
+         wraps++;
+      rounds++;
+      const uint64_t F = m.r.wSeq;
+      for (uint64_t S = m.S; S <= F; S++) {
+         for (int lv = NVRM_REC_REPLAY; lv <= NVRM_REC_DROP_ALL; lv++) {
+            for (int hp = 0; hp < 2; hp++) {
+               struct nvrm_rec_plan p;
+               if (nvrm_rec_plan(&m.r, S, (enum nvrm_rec_level)lv, hp != 0, &p) != 0) {
+                  if (!first_bad)
+                     first_bad = "a consistent ring was refused";
+                  continue;
+               }
+               plans++;
+               const uint64_t first = lv == NVRM_REC_REPLAY ? S + 2 : lv == NVRM_REC_REPLAY_ALL ? S + 1 : F + 1;
+               level_ranges_ok = level_ranges_ok && p.keepLo == first && p.keepHi == F &&
+                                 (lv != NVRM_REC_REPLAY_ALL || p.dropLo > p.dropHi) &&
+                                 (lv != NVRM_REC_DROP_ALL || S == F || (p.dropLo == S + 1 && p.dropHi == F)) &&
+                                 (lv != NVRM_REC_REPLAY || S == F || (p.dropLo == S + 1 && p.dropHi == S + 1));
+               memset(newFifo, 0xCD, sizeof(newFifo));
+               struct nvrm_rec_ring out;
+               nvrm_rec_fill(&m.r, &p, m.fifo, newFifo, pro, &out);
+               const char *bad = check_fill(&m, &p, newFifo, &out, pro);
+               if (bad && !first_bad)
+                  first_bad = bad;
+               /* the claim the rebuild rests on: a plan for S holds for every later S */
+               for (uint64_t S2 = S; S2 <= F && S2 < S + 3; S2++) {
+                  struct nvrm_rec_plan p2;
+                  monotonic = monotonic && nvrm_rec_plan(&m.r, S2, (enum nvrm_rec_level)lv, hp != 0, &p2) == 0;
+               }
+            }
+         }
+      }
+   }
+   if (first_bad)
+      printf("     (%s)\n", first_bad);
+   arm("plan/fill: kept flushes copied in order and unchanged, dropped ones absent, unflushed entries after GPPut, "
+       "records rebased, other slots zero (random rings, every S in flight, three levels, with and without prologue)",
+       first_bad == NULL && plans > 10000);
+   arm("plan/fill: the model wrapped the GPFIFO in some rings", wraps > 10);
+   arm("plan: the levels drop and keep what they say", level_ranges_ok);
+   arm("plan: a plan valid for S is valid for every later S up to F", monotonic);
+   (void)rounds;
+}
+
+static void
+test_plan_refusals(void)
+{
+   static struct model m;
+   rng = 12345;
+   model_build(&m, 200, 10, true);
+   while (m.r.wSeq - m.S < 4) {   /* at least four in flight */
+      model_flush(&m, 3);
+   }
+   const uint64_t S = m.S, F = m.r.wSeq;
+   struct nvrm_rec_plan p;
+   arm("refusal: the unchanged ring is accepted", nvrm_rec_plan(&m.r, S, NVRM_REC_REPLAY, true, &p) == 0);
+   unsigned iF = 0, iK = 0;
+   for (unsigned i = 0; i < NVRM_REC_RING; i++) {
+      if (m.r.slotSeq[i] == F)
+         iF = i;
+      if (m.r.slotSeq[i] == S + 3)
+         iK = i;
+   }
+   struct nvrm_rec_ring keep = m.r;
+   m.r.slotSeq[iK] = 0;
+   arm("refusal: a kept flush with no record", nvrm_rec_plan(&m.r, S, NVRM_REC_REPLAY, true, &p) != 0);
+   m.r = keep;
+   m.r.slotBeg[iK] = (m.r.slotBeg[iK] + 1) % NVRM_REC_FIFO;
+   arm("refusal: a gap between one flush's end and the next one's start", nvrm_rec_plan(&m.r, S, NVRM_REC_REPLAY, true, &p) != 0);
+   m.r = keep;
+   m.r.slotSeq[(iF + 1) % NVRM_REC_RING] = S + 3;
+   arm("refusal: a sequence number recorded twice", nvrm_rec_plan(&m.r, S, NVRM_REC_REPLAY, true, &p) != 0);
+   m.r = keep;
+   m.r.subPut = (m.r.subPut + 1) % NVRM_REC_FIFO;
+   arm("refusal: the last flush does not end at the last doorbell", nvrm_rec_plan(&m.r, S, NVRM_REC_REPLAY, true, &p) != 0);
+   m.r = keep;
+   arm("refusal: a semaphore above the last flushed number", nvrm_rec_plan(&m.r, F + 1, NVRM_REC_REPLAY, true, &p) != 0);
+   arm("refusal: DROP_ALL needs no record and is accepted even with a record missing",
+       (m.r.slotSeq[iK] = 0, nvrm_rec_plan(&m.r, S, NVRM_REC_DROP_ALL, true, &p) == 0));
+   m.r = keep;
+   /* a ring that holds more than fits after the prologue */
+   struct nvrm_rec_ring big;
+   memset(&big, 0, sizeof(big));
+   big.wSeq = 1;
+   big.slotSeq[0] = 1;
+   big.slotBeg[0] = 5;
+   big.slotPut[0] = 4;   /* wraps the whole FIFO */
+   big.subPut = 4;
+   big.gpPut = 4;
+   arm("refusal: a carry that does not fit the new GPFIFO with the prologue",
+       nvrm_rec_plan(&big, 0, NVRM_REC_REPLAY_ALL, true, &p) != 0);
+}
+
+static void
+test_root(void)
+{
+   struct nvrm_rec_view v[6];
+   memset(v, 0, sizeof(v));
+   for (unsigned i = 0; i < 6; i++) {
+      v[i].valid = true;
+      v[i].semVA = 0x1000 * (i + 1);
+      v[i].sem = 10;
+      v[i].flushed = 20;
+   }
+   arm("root: no acquire pending -> own slot", nvrm_rec_root(v, 6, 2) == 2);
+   v[0].acqVA = v[1].semVA;
+   v[0].acqSeq = 15;
+   arm("root: one hop", nvrm_rec_root(v, 6, 0) == 1);
+   v[1].acqVA = v[2].semVA;
+   v[1].acqSeq = 11;
+   v[2].acqVA = v[3].semVA;
+   v[2].acqSeq = 11;
+   v[3].acqVA = v[4].semVA;
+   v[3].acqSeq = 11;
+   arm("root: four hops", nvrm_rec_root(v, 6, 0) == 4);
+   v[4].acqVA = v[5].semVA;
+   v[4].acqSeq = 11;
+   arm("root: at most four hops", nvrm_rec_root(v, 6, 0) == 4);
+   v[4].acqVA = v[0].semVA;
+   arm("root: a cycle stops the walk", nvrm_rec_root(v, 6, 2) == 1 || nvrm_rec_root(v, 6, 2) == 4 ||
+       nvrm_rec_root(v, 6, 2) == 0);
+   memset(v, 0, sizeof(v));
+   for (unsigned i = 0; i < 6; i++) {
+      v[i].valid = true;
+      v[i].semVA = 0x1000 * (i + 1);
+      v[i].sem = 10;
+   }
+   v[0].acqVA = v[1].semVA;
+   v[0].acqSeq = 10;
+   arm("root: a satisfied acquire stops the walk", nvrm_rec_root(v, 6, 0) == 0);
+   v[0].acqSeq = 11;
+   v[0].changed = true;
+   arm("root: a changed notifier stops the walk", nvrm_rec_root(v, 6, 0) == 0);
+   v[0].changed = false;
+   v[1].valid = false;
+   arm("root: a channel of another device is ignored", nvrm_rec_root(v, 6, 0) == 0);
+   v[1].valid = true;
+   v[0].acqVA = v[0].semVA;
+   arm("root: an acquire on its own semaphore is not followed", nvrm_rec_root(v, 6, 0) == 0);
+}
