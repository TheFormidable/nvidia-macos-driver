+         kicked = true;
+         nvkmd_nvrm_slot_kick(hslot[0], hgen[0], log_obj);
       }
       /* b73: a polling step or a sleep on the completion event; remain (t < abs_timeout_ns here) keeps an
        * application's sleep inside its deadline */
@@ -540,3 +560,26 @@ nvkmd_nvrm_sync_get_type(struct nvkmd_nvrm_pdev *pdev)
    }
    return type;
 }
+
+/* The plugin asks, for a fence whose wait succeeded, whether its submission ran (nvkmd.h). No lock and no lookup while
+ * nothing was ever dropped in this process. */
+__attribute__((visibility("default"))) int
+nvmtl_nvk_fence_dropped_v1(VkDevice device, VkFence fence)
+{
+   (void)device;
+   if (__atomic_load_n(&nvrm_rec_dropped_total, __ATOMIC_ACQUIRE) == 0)
+      return 0;
+   VK_FROM_HANDLE(vk_fence, f, fence);
+   if (f == NULL)
+      return -1;
+   struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(vk_fence_get_active_sync(f));
+   if (s == NULL)
+      return -1;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   nvrm_gsub_reap(s);
+   const bool dropped = s->dropped;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (dropped)
+      nvrm_rec_count_fence_dropped();
+   return dropped ? 1 : 0;
+}
diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_chan_note_abi.h b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_chan_note_abi.h
new file mode 100644
index 0000000..35ee792
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_chan_note_abi.h
@@ -0,0 +1,72 @@
+/*
+ * NullMoth NVIDIA driver for macOS
+ * Copyright (c) 2026 NullMoth Systems.
+ * SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+ */
+
+/* nvrm_chan_note_abi.h - the channel note: NVK tells NVRM.kext what it did about a faulted or stalled channel, and
+ * learns the adapter's power state and the RM's Xid count in the same call.
+ *
+ * When a channel of a process faults, NVK rebuilds it instead of losing the device. The kext takes no part in the
+ * rebuild; it only keeps machine-wide read-only counters (debug.nvrm_chan_*, debug.nvrm_xid_*) so one place shows
+ * what every process did, and answers whether the GPU is running, asleep or lost, which decides whether a rebuild
+ * is worth trying. The escape carries fixed-size counters from an unprivileged process and nothing else: no pointer,
+ * bounded increments. A process can make the counters lie; nothing acts on them.
+ *
+ * Shared by the kext (C++) and NVK (C, a byte-identical copy that its patch adds as nvkmd/nvrm/nvrm_chan_note_abi.h;
+ * tools/test_shared_headers.py compares the two). Plain C, stdint only.
+ *
+ * A kext without the escape passes 0xE8 to the RM, which rejects an unknown command: the call fails, `status` stays 0,
+ * and the caller treats the power state as unknown and stops asking. No user-client selector and no capability bit. */
+#pragma once
+#include <stdint.h>
+/* Private escape through user-client selector 1. 0xE2 and 0xE3 are nvrm_surfshare_abi.h; the RM's own escapes are
+ * 0x27-0x5F and 0xC8-0xDB. */
+#define NVRM_ESC_CHAN_NOTE      0xE8u
+#define NVRM_CHAN_NOTE_VERSION  1u
+enum { NVRM_CN_QUERY = 0, NVRM_CN_KICK = 1, NVRM_CN_RECOVERED = 2, NVRM_CN_GAVE_UP = 3, NVRM_CN_INJECTED = 4,
+       NVRM_CN_WHAT_COUNT = 5 };
+enum { NVRM_CN_PM_RUNNING = 0, NVRM_CN_PM_SUSPENDED = 1, NVRM_CN_PM_LOST = 2 };   /* == NVRM::kGpuPm* */
+#define NVRM_CN_OK 1u
+struct NVRMChanNoteEsc {
+   uint32_t version;    /* in   NVRM_CHAN_NOTE_VERSION                                   offset  0 */
+   uint32_t what;       /* in   NVRM_CN_*                                                offset  4 */
+   uint32_t xid;        /* in   error-notifier info32, 0 = none (stall)                  offset  8 */
+   uint32_t dropped;    /* in   flushes not executed (RECOVERED), else 0                 offset 12 */
+   uint32_t kind;       /* in   enum nvrm_rec_kind (RECOVERED, GAVE_UP), else 0          offset 16 */
+   uint32_t why;        /* in   enum nvrm_rec_why (GAVE_UP), else 0                      offset 20 */
+   uint32_t pm;         /* out  NVRM_CN_PM_* of the adapter behind this connection       offset 24 */
+   uint32_t status;     /* out  NVRM_CN_OK when the kext handled it; the caller sends 0  offset 28 */
+   uint64_t xidCount;   /* out  debug.nvrm_xid_count                                     offset 32 */
+   uint32_t xidLast;    /* out  debug.nvrm_xid_last                                      offset 40 */
+   uint32_t reserved;   /* 0                                                             offset 44 */
+};                      /* 48 bytes, no padding */
+#ifdef __cplusplus
+static_assert(sizeof(struct NVRMChanNoteEsc) == 48, "NVRMChanNoteEsc is wire ABI");
+#else
+_Static_assert(sizeof(struct NVRMChanNoteEsc) == 48, "NVRMChanNoteEsc is wire ABI");
+#endif
+#ifdef KERNEL
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* The RM logged an Xid. ANY context: it is called from the RM's error log hook with RM locks held and possibly with
+ * preemption off, so it does two atomic stores and nothing else: no IOLock, no allocation, no IOLog, no wakeup.
+ * Safe before nvrm_chan_note_sysctls() and at any time until the kext unloads. */
+void nvrm_chan_note_xid(uint32_t xid);
+/* The escape's body, at the top of the user client's escape, before the connection's gate and the power gate, on the
+ * caller's thread, so that it answers during a GPU suspend and resume. `e` is the kernel's copy of the record and the
+ * caller has checked that the escape's size is exactly sizeof(struct NVRMChanNoteEsc); `pm` is the power state the kext
+ * reports for this adapter as NVRM_CN_PM_*, which reads SUSPENDED for as long as the kext holds RM calls for a sleep or
+ * wake - longer than the adapter's own running flag is clear. For an unknown version or `what` it leaves `status` 0 and
+ * writes nothing; otherwise it counts by `what` (bounded), fills pm, xidCount, xidLast and sets status NVRM_CN_OK.
+ * Atomics only: no lock, no RM call, never sleeps. The caller answers kIOReturnSuccess either way; the record is copied
+ * back as for every escape. */
+void nvrm_chan_note_handle(struct NVRMChanNoteEsc *e, uint32_t pm);
+/* Registers the read-only sysctls. Thread context, from the kext's sysctl registration block; a second call does
+ * nothing. They stay registered until the kext unloads. */
+void nvrm_chan_note_sysctls(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/nouveau/vulkan/nvmtl_cfg.h b/src/nouveau/vulkan/nvmtl_cfg.h
index 462b2a7..14442c9 100644
--- a/src/nouveau/vulkan/nvmtl_cfg.h
+++ b/src/nouveau/vulkan/nvmtl_cfg.h
@@ -1,27 +1,46 @@
 /* r3-cfgall: every NVK/NVRM/NVMTL switch also reads /Library/GPUBundles/nvmtl/nvrm610.conf
- * ("NAME=value" lines) when the env var is unset, so WindowServer (no shell env) can bisect the r3 hang. */
+ * ("NAME=value" lines) when the env var is unset, so WindowServer (no shell env) can bisect the r3 hang.
+ * The last line that begins with "NAME=" wins, the way the Metal plugin's own reader does: a shipped value above
+ * the user's own line no longer silently beats it, and a "# NAME=..." comment does not count, because the match
+ * must start a line. It differs from the plugin's reader (nvmtl_conf_read_file, plugin/NVMTLObjects.m) in four ways:
+ * - it looks only at the first 8191 bytes of the file, where the plugin reads the file whole, so a name whose only
+ *   line sits past that point is not seen here (nor one after a NUL byte, where this reader stops);
+ * - a line must begin with "NAME=" exactly: a line with blanks before the name or between the name and the "=" is
+ *   not taken here, where the plugin skips those blanks;
+ * - the value is everything up to the newline, a trailing CR or blanks included, where the plugin drops them (neither
+ *   reader drops blanks after the "=");
+ * - the value keeps at most 63 bytes, where the plugin reads a line in pieces of up to 511 bytes and takes each
+ *   further piece of a longer line as a line of its own.
+ * The installed file is far shorter than 8191 bytes, and in a Metal process the plugin has already set the variable,
+ * so getenv answers before this reader is reached. */
 #ifndef NVMTL_CFG_H
 #define NVMTL_CFG_H
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#ifndef NVMTL_CFG_PATH
+#define NVMTL_CFG_PATH "/Library/GPUBundles/nvmtl/nvrm610.conf"
+#endif
 static inline const char *nvmtl_cfg_getenv(const char *name)
 {
    const char *e = getenv(name);
    if (e) return e;
    static char conf[8192]; static int loaded;
    if (!loaded) {
       loaded = 1;
-      FILE *f = fopen("/Library/GPUBundles/nvmtl/nvrm610.conf", "r");
+      FILE *f = fopen(NVMTL_CFG_PATH, "r");
       if (f) { size_t n = fread(conf, 1, sizeof conf - 1, f); conf[n] = 0; fclose(f); }
    }
    char key[96]; snprintf(key, sizeof key, "%s=", name);
-   const char *h = strstr(conf, key);
-   if (!h || (h != conf && h[-1] != '\n')) return NULL;
-   static char val[8][64]; static unsigned vi; char *v = val[vi++ % 8]; size_t i = 0; h += strlen(key);
+   const char *last = NULL;
+   for (const char *h = strstr(conf, key); h; h = strstr(h + 1, key))
+      if (h == conf || h[-1] == '\n') last = h;
+   if (!last) return NULL;
+   const char *h = last + strlen(key);
+   static char val[8][64]; static unsigned vi; char *v = val[vi++ % 8]; size_t i = 0;
    while (h[i] && h[i] != '\n' && i < 63) { v[i] = h[i]; i++; }
    v[i] = 0;
    fprintf(stderr, "nvk-cfg: %s=%s (nvrm610.conf)\n", name, v);
    return v;
 }
