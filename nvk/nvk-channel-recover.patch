+   arm("classify: every allow-listed Xid with a changed notifier is CHANNEL (pm unknown or running, action unsupported)", all);
+   arm("classify: an allow-listed Xid without a changed notifier is not CHANNEL", cls(13, 0, -1, 0, 0, 0) == NVRM_LOSS_NONE);
