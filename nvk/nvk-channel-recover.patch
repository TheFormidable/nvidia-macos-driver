+static void
+test_drops(void)
+{
+   struct nvrm_rec_drops d;
+   memset(&d, 0, sizeof(d));
+   arm("drops: empty has nothing", !nvrm_rec_drops_has(&d, 1));
+   nvrm_rec_drops_add(&d, 5, 7);
+   arm("drops: membership inclusive", nvrm_rec_drops_has(&d, 5) && nvrm_rec_drops_has(&d, 7) &&
+       !nvrm_rec_drops_has(&d, 4) && !nvrm_rec_drops_has(&d, 8));
+   nvrm_rec_drops_add(&d, 9, 8);
+   arm("drops: an empty range is not added", d.n == 1);
+   for (uint64_t k = 0; k < 8; k++)
+      nvrm_rec_drops_add(&d, 100 + 10 * k, 100 + 10 * k);
+   arm("drops: nine ranges keep the newest eight", !nvrm_rec_drops_has(&d, 5) && nvrm_rec_drops_has(&d, 100) &&
+       nvrm_rec_drops_has(&d, 170));
+}
