+   bool oldest_gone = true;
+   for (unsigned i = 0; i < NVRM_REC_MAX_REBUILDS; i++)
+      oldest_gone = oldest_gone && s[i] != t;
+   arm("budget: a push replaces the oldest stamp", replaced && oldest_gone);
+   arm("budget: after it, three inside the window refuse again", !nvrm_rec_budget_ok(s, t + NVRM_REC_WINDOW_NS + 1));
+}
