+/* ── the order of the rebuild, with fake operations ── */
+struct fake {
+   char log[64];
+   unsigned n;
+   struct nvrm_rec_inputs in;
+   uint64_t sem[2];
+   unsigned semReads;
+   int buildRc, freeRc;
+   struct nvrm_rec_plan adopted;
+};
+
+static void f_note(struct fake *f, char c) { if (f->n < sizeof(f->log) - 1) f->log[f->n++] = c; f->log[f->n] = 0; }
+static void f_inputs(void *u, struct nvrm_rec_inputs *in) { struct fake *f = u; f_note(f, 'i'); *in = f->in; }
+static void f_action(void *u, struct nvrm_rec_inputs *in) { (void)in; f_note(u, 'r'); }
+static uint64_t f_sem(void *u) { struct fake *f = u; f_note(f, 's'); uint64_t v = f->sem[f->semReads < 1 ? 0 : 1]; f->semReads++; return v; }
+static int f_build(void *u) { struct fake *f = u; f_note(f, 'b'); return f->buildRc; }
+static void f_discard(void *u) { f_note(u, 'd'); }
+static int f_free(void *u) { struct fake *f = u; f_note(f, 'f'); return f->freeRc; }
+static void f_adopt(void *u, const struct nvrm_rec_ring *r, const struct nvrm_rec_plan *p) { struct fake *f = u; (void)r; f_note(f, 'a'); f->adopted = *p; }
+static void f_start(void *u, const struct nvrm_rec_plan *p) { (void)p; f_note(u, 't'); }
+static const struct nvrm_rec_ops fops = { f_inputs, f_action, f_sem, f_build, f_discard, f_free, f_adopt, f_start };
+
+static void
+state_ring(struct nvrm_rec_state *st, uint64_t S, uint64_t F)
+{
+   memset(st, 0, sizeof(*st));
+   /* flushes S+1..F, one entry each, in slots 0.. */
+   uint64_t put = 0;
+   for (uint64_t n = S + 1; n <= F; n++) {
+      const unsigned i = (unsigned)(n - S - 1);
+      st->ring.slotSeq[i] = n;
+      st->ring.slotBeg[i] = put;
+      st->ring.slotPut[i] = ++put;
+   }
+   st->ring.subPut = put;
+   st->ring.gpPut = put + 2;   /* two unflushed */
+   st->ring.wSeq = F;
+   st->havePrologue = true;
+   st->now = 1000000000000ll;
+}
+
+static int64_t asleep;   /* the channel's "GPU suspended" stamp, as nvrm_rec_run keeps it across runs */
+
+static enum nvrm_rec_why
+run(struct fake *f, const struct nvrm_rec_state *st, enum nvrm_rec_kind *k, enum nvrm_rec_level *lv)
+{
+   struct nvrm_rec_plan p;
+   f->n = 0;
+   f->log[0] = 0;
+   f->semReads = 0;
+   return nvrm_rec_execute(&fops, f, st, &asleep, k, lv, &p);
+}
+
+static void
+test_execute(void)
+{
+   struct nvrm_rec_state st;
+   struct fake f;
+   enum nvrm_rec_kind k;
+   enum nvrm_rec_level lv;
+   memset(&f, 0, sizeof(f));
+   state_ring(&st, 10, 15);
+   f.in.changed = 1;
+   f.in.xid = 13;
+   f.in.pm = -1;
+   f.sem[0] = 10;
+   f.sem[1] = 11;
+   arm("execute: a channel fault runs inputs, action, sem, build, free, sem, adopt, start in that order",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strcmp(f.log, "irsbfsat") == 0 && k == NVRM_LOSS_CHANNEL &&
+       lv == NVRM_REC_REPLAY);
+   arm("execute: the adopted plan uses the semaphore read after the free",
+       f.adopted.S == 11 && f.adopted.dropLo == 12 && f.adopted.dropHi == 12 && f.adopted.keepLo == 13);
+   f.in.xid = 120;
+   arm("execute: a non-recoverable kind never builds", run(&f, &st, &k, &lv) == NVRM_WHY_KIND && strcmp(f.log, "ir") == 0 &&
+       k == NVRM_LOSS_GSP);
+   f.in.xid = 13;
+   for (unsigned i = 0; i < NVRM_REC_MAX_REBUILDS; i++)
+      st.stamps[i] = st.now - 1000 - i;
+   arm("execute: an exhausted budget never builds", run(&f, &st, &k, &lv) == NVRM_WHY_BUDGET && strcmp(f.log, "ir") == 0);
+   memset(st.stamps, 0, sizeof(st.stamps));
+   st.ring.slotSeq[2] = 0;   /* flush 13 lost its record */
+   arm("execute: a refused plan never builds", run(&f, &st, &k, &lv) == NVRM_WHY_PLAN && strcmp(f.log, "irs") == 0);
+   state_ring(&st, 10, 15);
+   st.copyOnly = true;
+   st.replayedThrough = 12;
+   arm("execute: a copy-only refault never builds",
+       run(&f, &st, &k, &lv) == NVRM_WHY_COPY_REFAULT && strcmp(f.log, "irs") == 0);
+   st.replayedThrough = 10;
+   arm("execute: copy-only replays everything", run(&f, &st, &k, &lv) == NVRM_WHY_OK && lv == NVRM_REC_REPLAY_ALL &&
+       f.adopted.dropLo > f.adopted.dropHi && f.adopted.keepLo == 12);
+   f.in.xid = 71;   /* a copy-engine fault on this card's upload channel, which runs on copy engine 4 */
+   st.replayedThrough = 12;
+   arm("execute: a refault on copy engine 4 is a channel loss given up with COPY_REFAULT, and never builds",
+       run(&f, &st, &k, &lv) == NVRM_WHY_COPY_REFAULT && k == NVRM_LOSS_CHANNEL && strcmp(f.log, "irs") == 0);
+   st.replayedThrough = 10;
+   arm("execute: a copy-engine fault that does not refault rebuilds the copy-only channel",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && k == NVRM_LOSS_CHANNEL && lv == NVRM_REC_REPLAY_ALL);
+   f.in.xid = 13;
+   st.copyOnly = false;
+   f.buildRc = -1;
+   arm("execute: a failed build never frees the old channel", run(&f, &st, &k, &lv) == NVRM_WHY_BUILD &&
+       strcmp(f.log, "irsb") == 0);
+   f.buildRc = 0;
+   f.freeRc = -1;
+   arm("execute: a failed free discards the new channel and adopts nothing",
+       run(&f, &st, &k, &lv) == NVRM_WHY_FREE && strcmp(f.log, "irsbfd") == 0);
+   f.freeRc = 0;
+   st.replayedThrough = 12;
+   arm("execute: DROP_ALL exactly when the semaphore is below the replayed work on a graphics context",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && lv == NVRM_REC_DROP_ALL && f.adopted.dropLo == 12 && f.adopted.dropHi == 15);
+   st.replayedThrough = 10;
+   f.sem[0] = 10;
+   f.sem[1] = 10;
+   arm("execute: REPLAY when the semaphore is at the replayed work", run(&f, &st, &k, &lv) == NVRM_WHY_OK &&
+       lv == NVRM_REC_REPLAY);
+   f.in.changed = 0;
+   f.in.xid = 0;
+   arm("execute: nothing changed and nothing reported is a STALL, and is rebuilt", run(&f, &st, &k, &lv) == NVRM_WHY_OK &&
+       k == NVRM_LOSS_STALL);
+   f.in.changed = 1;
+   f.in.xid = 200;
+   arm("execute: an unknown Xid is not rebuilt", run(&f, &st, &k, &lv) == NVRM_WHY_KIND && k == NVRM_LOSS_UNKNOWN);
+   bool startAfterAdopt = true;
+   f.in.xid = 31;
+   for (unsigned t = 0; t < 4; t++) {
+      run(&f, &st, &k, &lv);
+      const char *a = strchr(f.log, 'a'), *s = strchr(f.log, 't');
+      startAfterAdopt = startAfterAdopt && a != NULL && s == a + 1 && s[1] == 0;
+   }
+   arm("execute: start always directly follows adopt, and nothing follows start", startAfterAdopt);
+}
+
+/* ── a stall while the GPU is suspended for a sleep or wake ── */
+static void
+test_asleep(void)
+{
+   struct nvrm_rec_state st;
+   struct fake f;
+   enum nvrm_rec_kind k;
+   enum nvrm_rec_level lv;
+   memset(&f, 0, sizeof(f));
+   state_ring(&st, 10, 15);
+   f.sem[0] = 10;
+   f.sem[1] = 10;
+   const int64_t T = st.now;
+   f.in.pm = 1;   /* NVRM_CN_PM_SUSPENDED */
+   asleep = 0;
+   arm("asleep: a stall on a suspended GPU looks again: no RM action, no semaphore read, no build, no free",
+       run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && strcmp(f.log, "i") == 0 && k == NVRM_LOSS_NONE && asleep == T);
+   f.in.pm = 0;   /* control: the same stall on a running GPU */
+   arm("asleep: control: the same stall on a running GPU is rebuilt, and the stamp is cleared",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strcmp(f.log, "irsbfsat") == 0 && k == NVRM_LOSS_STALL && asleep == 0);
+   f.in.pm = -1;
+   arm("asleep: an older kext (power state unknown) gets the sequence it always had",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strcmp(f.log, "irsbfsat") == 0 && k == NVRM_LOSS_STALL && asleep == 0);
+   f.in.pm = 1;
+   f.in.changed = 1;
+   f.in.xid = 13;
+   arm("asleep: a changed error notifier on a suspended GPU is not a stall: RM is asked and the fault rebuilt as before",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strncmp(f.log, "ir", 2) == 0 && k == NVRM_LOSS_CHANNEL && asleep == 0);
+   f.in.changed = 0;
+   f.in.xid = 0;
+   f.in.pm = 2;   /* NVRM_CN_PM_LOST: the wake failed */
+   arm("asleep: a GPU that did not come back is a lost resume, never looked at again",
+       run(&f, &st, &k, &lv) == NVRM_WHY_KIND && k == NVRM_LOSS_RESUME && asleep == 0);
+
+   /* the bound: a GPU that stays suspended */
+   f.in.pm = 1;
+   asleep = 0;
+   st.now = T;
+   bool looks = run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP;
+   for (int64_t dt = 5000000000ll; dt < NVRM_REC_ASLEEP_NS; dt += 5000000000ll) {   /* one look per 5 s budget */
+      st.now = T + dt;
+      looks = looks && run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && asleep == T;
+   }
+   st.now = T + NVRM_REC_ASLEEP_NS - 1;
+   looks = looks && run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP;
+   arm("asleep: every look inside NVRM_REC_ASLEEP_NS of the first suspended answer looks again, the stamp kept", looks);
+   st.now = T + NVRM_REC_ASLEEP_NS;
+   arm("asleep: once NVRM_REC_ASLEEP_NS of awake time has passed, the normal sequence runs (RM asked, stall rebuilt)",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strcmp(f.log, "irsbfsat") == 0 && k == NVRM_LOSS_STALL && asleep == T);
+   st.now = T + 3 * NVRM_REC_ASLEEP_NS;
+   arm("asleep: and keeps running it while the GPU stays suspended", run(&f, &st, &k, &lv) == NVRM_WHY_OK && asleep == T);
+   asleep = 0;   /* control: a caller that forgot the stamp between looks */
+   arm("asleep: control: without the kept stamp the same late look would look again (the stamp is what ends it)",
+       run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP);
+   f.in.pm = 0;
+   st.now = T + 4 * NVRM_REC_ASLEEP_NS;
+   run(&f, &st, &k, &lv);
+   f.in.pm = 1;
+   arm("asleep: a running answer clears the stamp, so the next sleep gets its own NVRM_REC_ASLEEP_NS",
+       asleep == 0 && run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && asleep == st.now);
+
+   /* the usual end of a sleep: no run at all after the wake (the channel moved on and the waits ended), so no running
+    * answer ever clears the stamp; hours later the machine sleeps again */
+   f.in.pm = 1;
+   asleep = 0;
+   st.now = T;
+   st.progNs = T - 3000000000ll;   /* the channel last moved 3 s before the first look */
+   bool first = run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && asleep == T;
+   st.now = T + 20000000000ll;
+   first = first && run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && asleep == T;
+   arm("asleep: a progress stamp older than the first suspended answer keeps the stamp (one sleep, one bound)", first);
+   st.progNs = T + 60000000000ll;               /* after the wake the channel ran */
+   st.now = T + 4 * 3600 * 1000000000ll;      /* the next sleep, four hours of awake time later */
+   arm("asleep: the next sleep, after the channel moved, looks again with a stamp of its own (no running answer between)",
+       run(&f, &st, &k, &lv) == NVRM_WHY_ASLEEP && strcmp(f.log, "i") == 0 && asleep == st.now);
+   st.now += NVRM_REC_ASLEEP_NS;
+   arm("asleep: and that sleep's own bound ends it",
+       run(&f, &st, &k, &lv) == NVRM_WHY_OK && strcmp(f.log, "irsbfsat") == 0 && asleep == st.now - NVRM_REC_ASLEEP_NS);
+   st.progNs = 0;
+
+   int64_t s0 = 0;
+   arm("asleep: the pure rule: suspended and unchanged only, and an awake clock of 0 still sets a stamp",
+       nvrm_rec_asleep(1, 0, 0, 0, &s0) && s0 == 1 && !nvrm_rec_asleep(1, 1, 5, 0, &s0) && s0 == 0 &&
+       !nvrm_rec_asleep(0, 0, 5, 0, &s0) && !nvrm_rec_asleep(-1, 0, 5, 0, &s0) && !nvrm_rec_asleep(2, 0, 5, 0, &s0) &&
+       s0 == 0);
+   s0 = 7;
+   arm("asleep: the pure rule: progress at or after the stamp starts a new one, progress before it keeps it",
+       nvrm_rec_asleep(1, 0, 9, 7, &s0) && s0 == 9 && nvrm_rec_asleep(1, 0, 12, 8, &s0) && s0 == 9);
+   arm("asleep: the reason has a name", strcmp(nvrm_rec_why_name(NVRM_WHY_ASLEEP), "?") != 0);
+   asleep = 0;
+}
+
+/* ── controls: the checkers must refuse a damaged result ── */
+static void
+test_controls(void)
+{
+   static const uint32_t pro[2] = { 1, 2 };
+   static struct model m;
+   rng = 777;
+   model_build(&m, 120, 20, true);
+   while (m.r.wSeq - m.S < 5)
+      model_flush(&m, 4);
+   struct nvrm_rec_plan p;
+   struct nvrm_rec_ring out;
+   const bool planned = nvrm_rec_plan(&m.r, m.S, NVRM_REC_REPLAY, true, &p) == 0;
+   nvrm_rec_fill(&m.r, &p, m.fifo, newFifo, pro, &out);
+   arm("control: the undamaged result passes the checker", planned && check_fill(&m, &p, newFifo, &out, pro) == NULL);
+   const uint32_t keep = newFifo[2 * 2];
+   newFifo[2 * 2] ^= 1;
+   arm("control: one carried entry changed is caught", check_fill(&m, &p, newFifo, &out, pro) != NULL);
+   newFifo[2 * 2] = keep;
+   struct nvrm_rec_plan bad = p;
+   bad.keepLo = p.dropLo;   /* a plan that would replay the flush that faulted */
+   arm("control: a plan that keeps the dropped flush is caught", check_fill(&m, &bad, newFifo, &out, pro) != NULL);
+   struct nvrm_rec_ring o2 = out;
+   for (unsigned i = 0; i < NVRM_REC_RING; i++)
+      if (o2.slotSeq[i] == 0) {
+         o2.slotSeq[i] = 3;
+         break;
+      }
+   arm("control: a stale ring slot left in the new ring is caught", check_fill(&m, &p, newFifo, &o2, pro) != NULL);
+   /* a classifier that rebuilt every changed notifier (the rejected rule) would call Xid 120 a channel fault */
+   const struct nvrm_rec_inputs gsp = { 120, 1, -1, 0, 0, 0 };
+   arm("control: the GSP crash is not a channel fault", nvrm_rec_classify(&gsp) != NVRM_LOSS_CHANNEL);
+}
+
+/* ── the root-alive test of nvrm_rec_run: a stamp made by the waiter's own kick is never recent progress ── */
+static void
+test_root_alive(void)
+{
+   const int64_t ms = 1000000, budget = 5000 * ms;
+   bool kick = true;
+   for (int64_t j = -10 * ms; j <= 10 * ms; j += ms / 4)   /* the kick's stamp, the check one round earlier or later */
+      kick = kick && !nvrm_rec_root_alive(budget, budget / 2 + j, budget);
+   arm("root alive: a change first seen by the waiter's kick (half a budget old +- 10 ms) is not recent progress", kick);
+   arm("root alive: a change seen by the stall check itself is recent progress", nvrm_rec_root_alive(budget, budget, budget));
+   arm("root alive: a change seen 1 s before the check (by the root's own waiter) is recent progress",
+       nvrm_rec_root_alive(budget, budget - 1000 * ms, budget));
+   arm("root alive: a stamp one budget old is not", !nvrm_rec_root_alive(budget, 0, budget));
+}
+
+int
+main(void)
+{
+   test_classify();
+   test_budget();
+   test_plan_fill();
+   test_plan_refusals();
+   test_root();
+   test_drops();
+   test_execute();
+   test_asleep();
+   test_root_alive();
+   test_controls();
+   printf("%u ok, %u failed\n", oks, fails);
+   return fails ? 1 : 0;
+}
