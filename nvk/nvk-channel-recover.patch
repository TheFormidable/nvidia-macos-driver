+rec_stat_set(unsigned i, uint64_t v)
+{
+   __atomic_store_n(&nvrm_rec_stats[i], v, __ATOMIC_RELAXED);
+}
+
+void
+nvrm_rec_count_fence_dropped(void)
+{
+   rec_stat_add(REC_ST_FENCES_DROPPED, 1);
+}
+
+/* ── switches and clocks ─────────────────────────────────────────────────────────────────────────────────────────── */
+
+bool
+nvrm_rec_enabled(void)
+{
+   static int on = -1;
+   int v = __atomic_load_n(&on, __ATOMIC_ACQUIRE);
+   if (v < 0) {
+      const char *e = nvmtl_cfg_getenv("NVK_CHANNEL_RECOVER");
+      v = !(e != NULL && e[0] == '0') && nvkmd_nvrm_async_on();
+      __atomic_store_n(&on, v, __ATOMIC_RELEASE);
+   }
+   return v != 0;
+}
+
+/* Awake time: a machine that sleeps in the middle of a wait does not wake to an expired stall budget. The absolute
+ * deadlines of vk_sync waits stay on os_time_get_nano. */
+int64_t
+nvrm_rec_now_ns(void)
+{
+#if defined(__APPLE__)
+   if (nvrm_rec_enabled())
+      return (int64_t)clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+#endif
+   return os_time_get_nano();
+}
+
+static int64_t
+rec_budget_ns(void)
+{
+   return nvkmd_nvrm_flush_timeout_ms() * 1000000LL;
+}
+
+static bool
+nvrm_rec_lock_bounded(pthread_mutex_t *m, int64_t limit_ns)
+{
+   const int64_t t0 = nvrm_rec_now_ns();
+   for (;;) {
+      const int rc = pthread_mutex_trylock(m);
+      if (rc == 0)
+         return true;
+      if (rc != EBUSY || nvrm_rec_now_ns() - t0 > limit_ns)
+         return false;
+      usleep(1000);
+   }
+}
+
+/* ── the kext's channel note ─────────────────────────────────────────────────────────────────────────────────────── */
+
+static int nvrm_rec_kext;   /* 0 not asked yet, 1 the kext answers escape 0xE8, 2 it does not (asked no more) */
+
+/* 0 = noted, the kext's answers in *e; -1 = no kext answer (an older kext: the power state is unknown) */
+static int
+rec_note(struct nvkmd_nvrm_pdev *pdev, uint32_t what, uint32_t xid, uint32_t dropped, uint32_t kind, uint32_t why,
+         int32_t *pm)
+{
+   if (pm != NULL)
+      *pm = -1;
+   if (pdev == NULL || __atomic_load_n(&nvrm_rec_kext, __ATOMIC_ACQUIRE) == 2)
+      return -1;
+   struct NVRMChanNoteEsc e;
+   memset(&e, 0, sizeof(e));
+   e.what = what;
+   e.xid = xid;
+   e.dropped = dropped;
+   e.kind = kind;
+   e.why = why;
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   if (nvRmApiChanNote(&rm, &e) != 0) {
+      int expect = 0;
+      __atomic_compare_exchange_n(&nvrm_rec_kext, &expect, 2, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+      return -1;
+   }
+   __atomic_store_n(&nvrm_rec_kext, 1, __ATOMIC_RELEASE);
+   if (pm != NULL && e.pm <= NVRM_CN_PM_LOST)
+      *pm = (int32_t)e.pm;
+   return 0;
+}
+
+/* ── the owner's side ────────────────────────────────────────────────────────────────────────────────────────────── */
+
+static bool
+rec_owner_applies(const struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   return ctx->slot1 != 0 && nvrm_rec_enabled();
+}
+
+VkResult
+nvrm_rec_enter(struct nvkmd_nvrm_exec_ctx *ctx, struct vk_object_base *log_obj)
+{
+   if (!rec_owner_applies(ctx))
+      return VK_SUCCESS;
+   if (ctx->recDepth > 0) {   /* an op called from another op of the same context */
+      ctx->recDepth++;
+      return VK_SUCCESS;
+   }
+   if (!nvrm_rec_lock_bounded(&nvrm_rec_mtx[ctx->slot1 - 1], 2 * rec_budget_ns())) {
+      fprintf(stderr, "nvrm: a channel rebuild has held this channel for more than %ld ms - the device is lost\n",
+              2 * nvkmd_nvrm_flush_timeout_ms());
+      return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel rebuild did not finish");
+   }
+   nvrm_rec_held++;
+   ctx->recDepth = 1;
+   ctx->recHeld = true;
+   return VK_SUCCESS;
+}
+
+void
+nvrm_rec_leave(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (ctx->recDepth == 0)
+      return;
+   if (--ctx->recDepth == 0 && ctx->recHeld) {
+      ctx->recHeld = false;
+      nvrm_rec_held--;
+      pthread_mutex_unlock(&nvrm_rec_mtx[ctx->slot1 - 1]);
+   }
+}
+
+bool
+nvrm_rec_release(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (!ctx->recHeld)
+      return false;
+   ctx->recHeld = false;
+   nvrm_rec_held--;
+   pthread_mutex_unlock(&nvrm_rec_mtx[ctx->slot1 - 1]);
+   return true;
+}
+
+VkResult
+nvrm_rec_retake(struct nvkmd_nvrm_exec_ctx *ctx, struct vk_object_base *log_obj)
+{
+   if (!nvrm_rec_lock_bounded(&nvrm_rec_mtx[ctx->slot1 - 1], 2 * rec_budget_ns())) {
+      fprintf(stderr, "nvrm: a channel rebuild has held this channel for more than %ld ms - the device is lost\n",
+              2 * nvkmd_nvrm_flush_timeout_ms());
+      return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel rebuild did not finish");
+   }
+   nvrm_rec_held++;
+   ctx->recHeld = true;
+   return VK_SUCCESS;
+}
+
+void
+nvrm_rec_mark_dying(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (ctx->slot1 == 0)
+      return;
+   const bool locked = nvrm_rec_enabled();
+   if (locked)
+      pthread_mutex_lock(&nvrm_rec_mtx[ctx->slot1 - 1]);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   nvkmd_nvrm_slots[ctx->slot1 - 1].dying = true;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (locked)
+      pthread_mutex_unlock(&nvrm_rec_mtx[ctx->slot1 - 1]);
+}
+
+void
+nvkmd_nvrm_set_reinit(struct nvkmd_ctx *_ctx, enum nvkmd_reinit which, const uint32_t *dw, uint32_t dw_count)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+   if ((unsigned)which >= NVKMD_REINIT_COUNT || !rec_owner_applies(ctx))
+      return;   /* never rebuilt: nothing to keep */
+   if (nvrm_rec_enter(ctx, NULL) != VK_SUCCESS) {
+      ctx->reinitBroken = true;   /* not kept: this context is never rebuilt */
+      return;
+   }
+   uint32_t *copy = NULL;
+   if (dw_count != 0) {
+      copy = malloc(sizeof(uint32_t) * dw_count);
+      if (copy == NULL)
+         ctx->reinitBroken = true;
+      else
+         memcpy(copy, dw, sizeof(uint32_t) * dw_count);
+   }
+   free(ctx->reinit[which].dw);
+   ctx->reinit[which].dw = copy;
+   ctx->reinit[which].n = copy != NULL ? dw_count : 0;
+   nvrm_rec_leave(ctx);
+}
+
+/* ── shared helpers ──────────────────────────────────────────────────────────────────────────────────────────────── */
+
+void
+nvrm_rec_observe(struct nvkmd_nvrm_slot *s, int64_t now)
+{
+   if (s->sem == NULL)
+      return;
+   const uint64_t v = __atomic_load_n(s->sem, __ATOMIC_ACQUIRE);
+   if (v != s->progVal) {
+      s->progVal = v;
+      s->progNs = now;
+   }
+}
+
+static const NvNotification *
+rec_err_notifier(const struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   return &((const NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+}
+
+/* Under nvkmd_nvrm_gsub_mtx: every registered channel of x's device, observed, as the root search needs it. */
+static void
+rec_views_locked(const struct nvkmd_nvrm_slot *x, int64_t now, struct nvrm_rec_view v[NVRM_CTX_MAX])
+{
+   for (uint32_t i = 0; i < NVRM_CTX_MAX; i++) {
+      struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[i];
+      memset(&v[i], 0, sizeof(v[i]));
+      if (s->ctx == NULL || s->dev != x->dev)
+         continue;
+      nvrm_rec_observe(s, now);
+      v[i].valid = true;
+      v[i].changed = (unsigned)rec_err_notifier(s->ctx)->status != s->errBase || s->injectFault;
+      v[i].sem = __atomic_load_n(s->sem, __ATOMIC_ACQUIRE);
+      v[i].flushed = s->flushed;
+      v[i].semVA = s->semVA;
+      v[i].acqVA = s->acqVA;
+      v[i].acqSeq = s->acqSeq;
+   }
+}
+
+static void
+rec_doorbell(struct nvkmd_nvrm_exec_ctx *ctx, uint32_t gpPut)
+{
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(ctx->base.dev->pdev);
+   const NvNotification *tok = &((const NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_WORK_SUBMIT_TOKEN];
+   KeplerBControlGPFifo *userD = ctx->userD->map;
+   userD->GPPut = gpPut;
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);   /* the same four steps as a submission (nvrm_gsub_submit) */
+   (void)*(volatile NvU32 *)&userD->GPPut;
+   volatile NvU32 *doorbell = (void *)((NvU8 *)pdev->usermodeMap.address + NVC361_NOTIFY_CHANNEL_PENDING);
+   *doorbell = tok->info32;
+}
+
+/* ── step 1 of the ladder: ring the doorbell again ─────────────────────────────────────────────────────────────────────────────── */
+
+void
+nvkmd_nvrm_slot_kick(uint32_t slot, uint32_t gen, struct vk_object_base *log_obj)
+{
+   (void)log_obj;
+   if (!nvrm_rec_enabled() || nvrm_rec_held != 0)
+      return;
+   const int64_t now = nvrm_rec_now_ns();
+   struct nvrm_rec_view v[NVRM_CTX_MAX];
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *x = &nvkmd_nvrm_slots[slot];
+   if (x->ctx == NULL || x->gen != gen) {
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      return;
+   }
+   rec_views_locked(x, now, v);
+   const uint32_t R = nvrm_rec_root(v, NVRM_CTX_MAX, slot);
+   struct nvkmd_nvrm_slot *r = &nvkmd_nvrm_slots[R];
+   const bool go = r->ctx != NULL && !r->recovering && !r->dying && !r->faulted && !r->gaveUp &&
+                   r->flushed > v[R].sem && r->kickVal != v[R].sem;
+   struct nvkmd_nvrm_exec_ctx *rctx = r->ctx;
+   const uint32_t rgen = r->gen;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (!go || pthread_mutex_trylock(&nvrm_rec_mtx[R]) != 0)
+      return;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   const bool still = r->ctx == rctx && r->gen == rgen && !r->dying && !r->recovering && !r->faulted;
+   if (still)
+      r->kickVal = __atomic_load_n(r->sem, __ATOMIC_ACQUIRE);
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   /* The device's pdev outlives every context of it, so it is taken under the mutex and used after: the note is an
+    * escape, and an escape may wait in the kernel (a kext older than the early answer holds it while the GPU sleeps),
+    * which must never happen with the context mutex held. */
+   struct nvkmd_nvrm_pdev *kpdev = NULL;
+   if (still) {
+      rec_doorbell(rctx, (uint32_t)rctx->subPut);
+      rec_stat_add(REC_ST_KICKS, 1);
+      kpdev = nvkmd_nvrm_pdev(rctx->base.dev->pdev);
+   }
+   pthread_mutex_unlock(&nvrm_rec_mtx[R]);
+   if (kpdev != NULL) {
+      rec_note(kpdev, NVRM_CN_KICK, 0, 0, 0, 0, NULL);
+      if (nvkmd_nvrm_diag_on())
+         fprintf(stderr, "nvrm: channel slot %u made no progress for half the stall budget - doorbell rung again\n", R);
+   }
+}
+
+/* ── steps 2 and 3 of the ladder: the rebuild ──────────────────────────────────────────────────────────────────────────────────── */
+
+struct rec_job {
+   struct nvkmd_nvrm_exec_ctx *ctx;
+   uint32_t slot;
+   struct nvkmd_nvrm_pdev *pdev;
+   struct vk_object_base *log_obj;
+   struct nvkmd_nvrm_exec_ctx *donor;      /* the new channel, until adopted */
+   struct nvkmd_mem *prologue;             /* the channel-wide state for the new channel, until adopted */
+   uint32_t prologueEntry[2];
+   uint32_t xid;
+   int64_t now;
+   /* what the adopt step took out of the context: freed after the new channel was started */
+   struct nvkmd_mem *oldMem[3 + 5 + 1];
+   uint64_t dropped, replayed;
+};
+
+static void
+rec_op_inputs(void *u, struct nvrm_rec_inputs *in)
+{
+   struct rec_job *j = u;
+   const NvNotification *errN = rec_err_notifier(j->ctx);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   const unsigned base = nvkmd_nvrm_slots[j->slot].errBase;
+   const bool inj = nvkmd_nvrm_slots[j->slot].injectFault;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   const unsigned st = (unsigned)errN->status;
+   in->changed = st != base || inj;
+   in->xid = st != base ? (uint32_t)errN->info32 : inj ? 13u : 0u;   /* the test hook reports a graphics exception */
+   j->xid = in->xid;
+   int32_t pm = -1;
+   (void)rec_note(j->pdev, NVRM_CN_QUERY, 0, 0, 0, 0, &pm);
+   in->pm = pm;
+}
+
+/* An RM control: during a GPU suspend and resume it waits in the kernel until the resume, so it is asked only when
+ * the power state did not already decide (nvrm_rec_execute). */
+static void
+rec_op_action(void *u, struct nvrm_rec_inputs *in)
+{
+   struct rec_job *j = u;
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(j->pdev, &rm);
+   NV2080_CTRL_GPU_GET_RECOVERY_ACTION_PARAMS ap;
+   memset(&ap, 0, sizeof(ap));
+   in->actionRc = nvRmApiControl(&rm, j->pdev->hSubdevice, NV2080_CTRL_CMD_GPU_GET_RECOVERY_ACTION, &ap, sizeof(ap));
+   in->actionAsked = 1;
+   in->action = (uint32_t)ap.action;
+}
+
+static uint64_t
+rec_op_read_sem(void *u)
+{
+   struct rec_job *j = u;
+   return __atomic_load_n((const uint64_t *)j->ctx->sem->map, __ATOMIC_ACQUIRE);
+}
+
+static void
+rec_op_discard(void *u)
+{
+   struct rec_job *j = u;
+   if (j->prologue != NULL)
+      nvkmd_mem_unref(j->prologue);
+   j->prologue = NULL;
+   if (j->donor != NULL)
+      nvkmd_ctx_destroy(&j->donor->base);
+   j->donor = NULL;
+}
+
+static int
+rec_op_build(void *u)
+{
+   struct rec_job *j = u;
+   struct nvkmd_nvrm_exec_ctx *ctx = j->ctx;
+   struct nvkmd_ctx *d = NULL;
+   if (nvkmd_nvrm_create_exec_ctx_on(ctx->base.dev, j->log_obj, ctx->engines, ctx->ceOnly, ctx, &d) != VK_SUCCESS)
+      return -1;
+   j->donor = nvkmd_nvrm_exec_ctx(d);
+   if (j->donor->ceOnly != ctx->ceOnly || (!ctx->ceOnly && (j->donor->hTsg == 0 || j->donor->hCtxShare == 0))) {
+      fprintf(stderr, "nvrm: the rebuilt channel did not come up in the old one's shape (copy engine %d/%d, group 0x%x)\n",
+              (int)j->donor->ceOnly, (int)ctx->ceOnly, (unsigned)j->donor->hTsg);
+      rec_op_discard(j);
+      return -1;
+   }
+   uint64_t n = 0;
+   for (unsigned k = 0; k < NVKMD_REINIT_COUNT; k++)
+      n += ctx->reinit[k].n;
+   if (n != 0) {
+      const uint64_t size = align64(n * 4, 0x1000);
+      if (size > 0x10000 ||
+          nvkmd_dev_alloc_mapped_mem(ctx->base.dev, j->log_obj, size, 0x1000, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,
+                                     &j->prologue) != VK_SUCCESS) {
+         j->prologue = NULL;
+         rec_op_discard(j);
+         return -1;
+      }
+      uint32_t *p = j->prologue->map;
+      for (unsigned k = 0; k < NVKMD_REINIT_COUNT; k++) {
+         if (ctx->reinit[k].n != 0)
+            memcpy(p, ctx->reinit[k].dw, 4 * (size_t)ctx->reinit[k].n);
+         p += ctx->reinit[k].n;
+      }
+      __atomic_thread_fence(__ATOMIC_SEQ_CST);
+      const struct nvkmd_ctx_exec e = { .addr = j->prologue->va->addr, .size_B = (uint32_t)(n * 4) };
+      nvrm_gp_entry_encode(&e, j->prologueEntry);
+   }
+   return 0;
+}
+
+static int
+rec_op_free_old(void *u)
+{
+   struct rec_job *j = u;
+   struct nvkmd_nvrm_exec_ctx *ctx = j->ctx;
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(j->pdev, &rm);
+   const NvU32 rc = nvRmApiFree(&rm, ctx->hChannel);   /* RM frees the engine objects under it */
+   if (rc != NV_OK) {
+      fprintf(stderr, "nvrm: the faulted channel 0x%x could not be freed (rc 0x%x)\n", (unsigned)ctx->hChannel,
+              (unsigned)rc);
+      return -1;
+   }
+   ctx->hChannel = 0;
+   memset(&ctx->subchannels, 0, sizeof(ctx->subchannels));
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);   /* nvmtl_nvk_tsg_reprioritise_v1 reads hTsg under it */
+   const NvHandle hTsg = ctx->hTsg, hShare = ctx->hCtxShare;
+   ctx->hTsg = 0;
+   ctx->hCtxShare = 0;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   nvRmApiFree(&rm, hShare);
+   nvRmApiFree(&rm, hTsg);
+   nvRmApiFree(&rm, ctx->hCtxDma);
+   ctx->hCtxDma = 0;
+   return 0;
+}
+
+static void
+rec_op_adopt(void *u, const struct nvrm_rec_ring *ring, const struct nvrm_rec_plan *p)
+{
+   struct rec_job *j = u;
+   struct nvkmd_nvrm_exec_ctx *ctx = j->ctx, *d = j->donor;
+   struct nvrm_rec_ring out;
+   /* the new GPFIFO is the new channel's own memory, not seen by any GPU yet; the old one is only read */
+   nvrm_rec_fill(ring, p, ctx->gpFifo->map, d->gpFifo->map, j->prologueEntry, &out);
+   const bool dropped = p->dropLo <= p->dropHi;
+   j->dropped = dropped ? p->dropHi - p->dropLo + 1 : 0;
+   j->replayed = p->keepLo <= p->keepHi ? p->keepHi - p->keepLo + 1 : 0;
+   const uint64_t S = p->S;
+   const int64_t now = nvrm_rec_now_ns();
+   const unsigned newBase = (unsigned)rec_err_notifier(d)->status;
+
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   unsigned m = 0;
+   j->oldMem[m++] = ctx->notifier;
+   j->oldMem[m++] = ctx->userD;
+   j->oldMem[m++] = ctx->gpFifo;
+   for (unsigned b = 0; b < ARRAY_SIZE(ctx->preempt); b++)
+      j->oldMem[m++] = ctx->preempt[b];
+   j->oldMem[m++] = ctx->zcull;
+   ctx->notifier = d->notifier;
+   ctx->userD = d->userD;
+   ctx->gpFifo = d->gpFifo;
+   memcpy(ctx->preempt, d->preempt, sizeof(ctx->preempt));
+   ctx->zcull = d->zcull;
+   ctx->hCtxDma = d->hCtxDma;
+   ctx->hChannel = d->hChannel;
+   ctx->hTsg = d->hTsg;
+   ctx->hCtxShare = d->hCtxShare;
+   ctx->subchannels = d->subchannels;
+   d->notifier = d->userD = d->gpFifo = d->zcull = NULL;
+   memset(d->preempt, 0, sizeof(d->preempt));
+   d->hCtxDma = d->hChannel = d->hTsg = d->hCtxShare = 0;
+   memset(&d->subchannels, 0, sizeof(d->subchannels));
+
+   ctx->gpGet = 0;
+   ctx->gpPut = out.gpPut;
+   ctx->subPut = out.subPut;
+   memcpy(ctx->slotSeq, out.slotSeq, sizeof(ctx->slotSeq));
+   memcpy(ctx->slotBeg, out.slotBeg, sizeof(ctx->slotBeg));
+   memcpy(ctx->slotPut, out.slotPut, sizeof(ctx->slotPut));
+   ctx->recEpoch++;
+
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[j->slot];
+   s->errBase = newBase;
+   s->faulted = false;
+   s->injectFault = false;
+   s->replayedThrough = p->F;
+   s->progVal = dropped && p->dropHi > S ? p->dropHi : S;
+   s->progNs = now;
+   s->kickVal = UINT64_MAX;
+   nvrm_rec_budget_push(s->rebuildNs, now);
+   if (dropped) {
+      nvrm_rec_drops_add(&s->drops, p->dropLo, p->dropHi);
+      __atomic_fetch_add(&nvrm_rec_dropped_total, j->dropped, __ATOMIC_RELEASE);
+   }
+   nvkmd_nvrm_tsg_rebind_locked(j->slot, ctx);
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+
+   /* the surface fence follows the new error notifier (the old one is still mapped: it is freed after this) */
+   (void)nvkmd_nvrm_fence_chan_rebind(ctx);
+
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   if (dropped) {
+      /* the dropped flushes are reported done; the old channel is gone and the new one has not been told about the
+       * work after them yet, so the semaphore never moves backwards */
+      uint64_t *sem = ctx->sem->map;
+      if (__atomic_load_n(sem, __ATOMIC_ACQUIRE) < p->dropHi)
+         __atomic_store_n(sem, p->dropHi, __ATOMIC_RELEASE);
+      __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   }
+   __atomic_store_n(&s->epoch, s->epoch + 1, __ATOMIC_RELEASE);
+   s->recovering = false;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+}
+
+static void
+rec_op_start(void *u, const struct nvrm_rec_plan *p)
+{
+   struct rec_job *j = u;
+   if (p->newSubPut != 0)
+      rec_doorbell(j->ctx, p->newSubPut);
+}
+
+static const struct nvrm_rec_ops nvrm_rec_rm_ops = {
+   .inputs = rec_op_inputs,
+   .action = rec_op_action,
+   .read_sem = rec_op_read_sem,
+   .build = rec_op_build,
+   .discard = rec_op_discard,
+   .free_old = rec_op_free_old,
+   .adopt = rec_op_adopt,
+   .start = rec_op_start,
+};
+
+/* What the 2.9 lines print, read under nvkmd_nvrm_gsub_mtx (no dereference of the context after it). */
+struct rec_diag {
+   bool have;
+   unsigned base, status, info32, info16, gpGet, gpPut;
+   uint64_t sem, flushed;
+   NvHandle hChannel;
+   struct nvkmd_nvrm_pdev *pdev;
+};
+
+static void
+rec_diag_locked(const struct nvkmd_nvrm_slot *s, struct rec_diag *d)
+{
+   const struct nvkmd_nvrm_exec_ctx *ctx = s->ctx;
+   const NvNotification *errN = rec_err_notifier(ctx);
+   const KeplerBControlGPFifo *userD = ctx->userD->map;
+   d->have = true;
+   d->base = s->errBase;
+   d->status = (unsigned)errN->status;
+   d->info32 = (unsigned)errN->info32;
+   d->info16 = (unsigned)errN->info16;
+   d->gpGet = userD->GPGet;
+   d->gpPut = userD->GPPut;
+   d->sem = __atomic_load_n(s->sem, __ATOMIC_ACQUIRE);
+   d->flushed = s->flushed;
+   d->hChannel = ctx->hChannel;
+   d->pdev = nvkmd_nvrm_pdev(ctx->base.dev->pdev);
+}
+
+static void
+rec_fault_info(const struct rec_diag *d)
+{
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(d->pdev, &rm);
+   NV906F_CTRL_GET_MMU_FAULT_INFO_PARAMS fi;
+   memset(&fi, 0, sizeof(fi));
+   int frc = nvRmApiControl(&rm, d->hChannel, NV906F_CTRL_CMD_GET_MMU_FAULT_INFO, &fi, sizeof fi);
+   fprintf(stderr, "nvrm: MMU fault info (rc %d): addr 0x%08x%08x type 0x%x \"%s\" compute shader VA 0x%llx\n", frc,
+           fi.addrHi, fi.addrLo, fi.faultType, fi.faultString,
+           (unsigned long long)fi.shaderProgramVA[NV906F_CTRL_MMU_FAULT_SHADER_TYPE_COMPUTE]);
+}
+
+/* The 2.9 result for the trigger, with the 2.9 lines, and the line that says why the channel was not rebuilt. */
+static VkResult
+rec_fail(enum nvrm_rec_trigger trig, enum nvrm_rec_why why, enum nvrm_rec_kind kind, uint32_t xid, uint32_t slot,
+         const struct rec_diag *d, bool report, bool faultInfo, uint64_t want, long ms, struct vk_object_base *log_obj)
+{
+   rec_stat_add(REC_ST_GAVE_UP, 1);
+   rec_stat_set(REC_ST_LAST_XID, xid);
+   rec_stat_set(REC_ST_LAST_KIND, kind);
+   rec_stat_set(REC_ST_LAST_WHY, why);
+   if (d->have)
+      rec_note(d->pdev, NVRM_CN_GAVE_UP, xid, 0, kind, why, NULL);
+   if (trig == NVRM_TRIG_FAULT) {
+      if (report && d->have) {
+         fprintf(stderr, "nvrm: channel FAULTED (error notifier status 0x%x -> 0x%x, info32 0x%x) at sem %llu of %llu flushed\n",
+                 d->base, d->status, d->info32, (unsigned long long)d->sem, (unsigned long long)d->flushed);
+         if (faultInfo)
+            rec_fault_info(d);
+      }
+   } else if (d->have) {
+      fprintf(stderr, "nvrm: wait TIMEOUT - no progress in %ld ms: sem %llu want %llu (flushed %llu)  GPGet %u GPPut %u  error notifier status 0x%x info32 0x%x info16 0x%x\n",
+              ms, (unsigned long long)d->sem, (unsigned long long)want, (unsigned long long)d->flushed, d->gpGet,
+              d->gpPut, d->status, d->info32, d->info16);
+      if (faultInfo)
+         rec_fault_info(d);
+      fprintf(stderr, "nvrm: NO channel fault was reported in %ld ms. The GPU was still working; this DEADLINE is the only reason the device is being called lost. Raise NVRM_FLUSH_TIMEOUT_MS if the work is legitimate.\n", ms);
+   }
+   if (report || trig == NVRM_TRIG_STALL) {
+      fprintf(stderr, "nvrm: channel slot %u not rebuilt: loss kind %s (Xid %u), %s\n", slot, nvrm_rec_kind_name(kind),
+              (unsigned)xid, nvrm_rec_why_name(why));
+      if (log_obj != NULL)
+         vk_logw(VK_LOG_OBJS(log_obj), "nvrm channel slot %u not rebuilt: loss kind %s (Xid %u), %s", slot,
+                 nvrm_rec_kind_name(kind), (unsigned)xid, nvrm_rec_why_name(why));
+   }
+   if (trig == NVRM_TRIG_FAULT)
+      return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel faulted");
+   return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel made no progress within NVRM_FLUSH_TIMEOUT_MS");
+}
+
+/* ASLEEP is never final (and never reaches here: nvrm_rec_run gives the claim back before), nor are BUSY, DYING,
+ * ROOT_ALIVE and GAVE_UP_BEFORE. */
+static bool
+rec_why_is_final(enum nvrm_rec_why w)
+{
+   return w == NVRM_WHY_KIND || w == NVRM_WHY_BUDGET || w == NVRM_WHY_PLAN || w == NVRM_WHY_BUILD ||
+          w == NVRM_WHY_FREE || w == NVRM_WHY_SHAPE || w == NVRM_WHY_BLOBS || w == NVRM_WHY_COPY_REFAULT;
+}
+
+VkResult
+nvrm_rec_run(uint32_t slot, uint32_t gen, enum nvrm_rec_trigger trig, uint64_t want, long ms,
+             struct vk_object_base *log_obj)
+{
+   const int64_t budget = rec_budget_ns();
+   int64_t now = nvrm_rec_now_ns();
+   struct nvrm_rec_view v[NVRM_CTX_MAX];
+   struct rec_diag d;
+   memset(&d, 0, sizeof(d));
+
+   /* 1. claim, under the slot table's mutex */
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *x = &nvkmd_nvrm_slots[slot];
+   if (x->ctx == NULL || x->gen != gen) {
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      return VK_SUCCESS;   /* unregistered, so it was idled: the caller looks again (2.9) */
+   }
+   rec_views_locked(x, now, v);
+   uint32_t R = trig == NVRM_TRIG_FAULT ? slot : nvrm_rec_root(v, NVRM_CTX_MAX, slot);
+   if (R != slot && v[R].sem >= v[R].flushed)
+      R = slot;   /* the channel waited on is idle: what does not move is the waiter's own channel */
+   struct nvkmd_nvrm_slot *r = &nvkmd_nvrm_slots[R];
+   enum nvrm_rec_why why = NVRM_WHY_OK;
+   if (r->dying) {
+      why = NVRM_WHY_DYING;
+   } else if (r->faulted || r->gaveUp) {
+      why = NVRM_WHY_GAVE_UP_BEFORE;
+   } else if (r->recovering) {
+      if (now - r->recStartNs <= 2 * budget) {
+         pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+         return VK_SUCCESS;
+      }
+      why = NVRM_WHY_BUSY;
+   } else if (!v[R].changed) {
+      if (trig == NVRM_TRIG_FAULT ||                          /* rebuilt already by someone else */
+          v[R].sem >= v[R].flushed || (R == slot && v[slot].sem >= want)) {
+         pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+         return VK_SUCCESS;
+      }
+      if (nvrm_rec_root_alive(now, r->progNs, budget)) {
+         if (R == slot) {
+            pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+            return VK_SUCCESS;                                /* it moved meanwhile: the waiter re-arms */
+         }
+         why = NVRM_WHY_ROOT_ALIVE;
+      }
+   }
+   rec_diag_locked(x, &d);
+   bool report = false;
+   if (why != NVRM_WHY_OK) {
+      /* before the claim: no flag of R changes; a fault of the waited channel itself is sticky, as in 2.9 */
+      if (trig == NVRM_TRIG_FAULT && v[slot].changed && !x->faulted)
+         x->faulted = report = true;
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      return rec_fail(trig, why, NVRM_LOSS_NONE, v[slot].changed ? d.info32 : 0, slot, &d, report,
+                      why != NVRM_WHY_DYING, want, ms, log_obj);
+   }
+   r->recovering = true;
+   r->recStartNs = now;
+   struct nvkmd_nvrm_exec_ctx *ctx = r->ctx;
+   const uint32_t rgen = r->gen;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+
+   /* 2. lock the channel, then make sure it is still the one claimed */
+   bool locked = false;
+   if (nvrm_rec_held != 0) {
+      why = NVRM_WHY_BUSY;   /* never two context mutexes */
+   } else if (!nvrm_rec_lock_bounded(&nvrm_rec_mtx[R], budget)) {
+      why = NVRM_WHY_BUSY;
+   } else {
+      locked = true;
+      nvrm_rec_held++;
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      if (r->ctx != ctx || r->gen != rgen || r->dying)
+         why = NVRM_WHY_DYING;
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   }
+
+   /* 3. what a rebuild needs */
+   if (why == NVRM_WHY_OK) {
+      if (!ctx->gsub || (!ctx->ceOnly && (ctx->hTsg == 0 || ctx->hCtxShare == 0)))
+         why = NVRM_WHY_SHAPE;
+      else if (ctx->reinitBroken || ((ctx->engines & ~NVKMD_ENGINE_COPY) != 0 && ctx->reinit[NVKMD_REINIT_CONTEXT].n == 0))
+         why = NVRM_WHY_BLOBS;
+   }
+
+   /* 4. the sequence (nvkmd_nvrm_recover.h) */
+   enum nvrm_rec_kind kind = NVRM_LOSS_NONE;
+   enum nvrm_rec_level level = NVRM_REC_REPLAY;
+   struct nvrm_rec_plan plan;
+   memset(&plan, 0, sizeof(plan));
+   struct rec_job job;
+   memset(&job, 0, sizeof(job));
+   const int64_t t0 = nvrm_rec_now_ns();
+   if (why == NVRM_WHY_OK) {
+      job.ctx = ctx;
+      job.slot = R;
+      job.pdev = nvkmd_nvrm_pdev(ctx->base.dev->pdev);
+      job.log_obj = log_obj;
+      job.now = t0;
+      struct nvrm_rec_state st;
+      memset(&st, 0, sizeof(st));
+      memcpy(st.ring.slotSeq, ctx->slotSeq, sizeof(st.ring.slotSeq));
+      memcpy(st.ring.slotBeg, ctx->slotBeg, sizeof(st.ring.slotBeg));
+      memcpy(st.ring.slotPut, ctx->slotPut, sizeof(st.ring.slotPut));
+      st.ring.subPut = ctx->subPut;
+      st.ring.gpPut = ctx->gpPut;
+      st.ring.wSeq = ctx->wSeq;
+      st.copyOnly = ctx->engines == NVKMD_ENGINE_COPY;
+      for (unsigned k = 0; k < NVKMD_REINIT_COUNT; k++)
+         st.havePrologue = st.havePrologue || ctx->reinit[k].n != 0;
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      st.replayedThrough = r->replayedThrough;
+      memcpy(st.stamps, r->rebuildNs, sizeof(st.stamps));
+      st.progNs = r->progNs;
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      st.now = t0;
+      why = nvrm_rec_execute(&nvrm_rec_rm_ops, &job, &st, &ctx->recAsleepNs, &kind, &level, &plan);
+   }
+
+   if (why == NVRM_WHY_ASLEEP) {
+      /* the GPU is suspended for a system sleep or wake: the channel stands still on purpose, and nothing was asked of
+       * RM, built or freed. The claim is given back and the waiter looks again with a fresh stall clock, as while
+       * another thread rebuilds; nothing is counted, reported or remembered as given up. */
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      if (r->ctx == ctx && r->gen == rgen)
+         r->recovering = false;
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      if (nvkmd_nvrm_diag_on())
+         fprintf(stderr, "nvrm: channel slot %u stands still while the GPU is suspended for a sleep or wake - waiting again\n", R);
+      nvrm_rec_held--;
+      pthread_mutex_unlock(&nvrm_rec_mtx[R]);
+      return VK_SUCCESS;
+   }
+
+   if (why != NVRM_WHY_OK) {
+      /* after the claim: give it back; a notifier that changed stays a sticky fault, a reason that cannot change is
+       * remembered, and the 2.9 verdict is returned */
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      if (r->ctx == ctx && r->gen == rgen) {
+         const bool changed = (unsigned)rec_err_notifier(ctx)->status != r->errBase || r->injectFault;
+         r->recovering = false;
+         if (why != NVRM_WHY_DYING && changed && !r->faulted)
+            r->faulted = report = true;
+         if (rec_why_is_final(why))
+            r->gaveUp = true;
+      }
+      /* the 2.9 lines describe the waited channel, as 2.9 printed them */
+      if (why != NVRM_WHY_DYING && x->ctx != NULL && x->gen == gen)
+         rec_diag_locked(x, &d);
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      const VkResult res = rec_fail(trig, why, kind, job.xid, R, &d, report, locked && why != NVRM_WHY_DYING,
+                                    want, ms, log_obj);
+      if (locked) {
+         nvrm_rec_held--;
+         pthread_mutex_unlock(&nvrm_rec_mtx[R]);
+      }
+      return res;
+   }
+
+   /* 5. clean up: the old channel's memories go after the channel (freed in free_old) */
+   for (unsigned m = 0; m < ARRAY_SIZE(job.oldMem); m++)
+      if (job.oldMem[m] != NULL)
+         nvkmd_mem_unref(job.oldMem[m]);
+   if (ctx->recPrologue != NULL)
+      nvkmd_mem_unref(ctx->recPrologue);
+   ctx->recPrologue = job.prologue;
+   FREE(job.donor);   /* it gave everything away: only the struct is left */
+   const int64_t us = (nvrm_rec_now_ns() - t0) / 1000;
+   rec_stat_add(level == NVRM_REC_DROP_ALL ? REC_ST_DROP_ALLS : REC_ST_REPLAYS, 1);
+   rec_stat_add(REC_ST_DROPPED, job.dropped);
+   rec_stat_add(REC_ST_REPLAYED, job.replayed);
+   rec_stat_set(REC_ST_LAST_XID, job.xid);
+   rec_stat_set(REC_ST_LAST_KIND, kind);
+   rec_stat_set(REC_ST_LAST_WHY, NVRM_WHY_OK);
+   rec_stat_set(REC_ST_LAST_US, (uint64_t)us);
+   uint64_t longest = __atomic_load_n(&nvrm_rec_stats[REC_ST_LONGEST_US], __ATOMIC_RELAXED);
+   while ((uint64_t)us > longest &&
+          !__atomic_compare_exchange_n(&nvrm_rec_stats[REC_ST_LONGEST_US], &longest, (uint64_t)us, false,
+                                       __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      ;
+   rec_note(job.pdev, NVRM_CN_RECOVERED, job.xid, (uint32_t)job.dropped, kind, NVRM_WHY_OK, NULL);
+   static const char *const lvname[] = { "replay", "replay all", "drop all" };
+   fprintf(stderr, "nvrm: channel slot %u rebuilt after a %s loss (Xid %u): %llu flush(es) dropped, %llu replayed (%s), %lld us\n",
+           R, nvrm_rec_kind_name(kind), (unsigned)job.xid, (unsigned long long)job.dropped,
+           (unsigned long long)job.replayed, lvname[level], (long long)us);
+   if (log_obj != NULL)
+      vk_logw(VK_LOG_OBJS(log_obj), "nvrm channel slot %u rebuilt after a %s loss (Xid %u): %llu flush(es) dropped, %llu replayed",
+              R, nvrm_rec_kind_name(kind), (unsigned)job.xid, (unsigned long long)job.dropped,
+              (unsigned long long)job.replayed);
+   nvrm_rec_held--;
+   pthread_mutex_unlock(&nvrm_rec_mtx[R]);
+   return VK_SUCCESS;
+}
+
+/* ── the test hook ───────────────────────────────────────────────────────────────────────────────────────────────── */
+
+static struct {
+   pthread_once_t once;
+   int mode;
+   unsigned n;
+   const void *ctx;      /* the first non-copy context that flushed */
+   unsigned count;
+   bool done;
+} nvrm_rec_inj = { .once = PTHREAD_ONCE_INIT };
+
+static void
+rec_inject_parse(void)
+{
+   const char *e = nvmtl_cfg_getenv("NVK_FAULT_INJECT");   /* a rotating static buffer: copied */
+   if (e == NULL)
+      return;
+   char buf[96];
+   snprintf(buf, sizeof buf, "%s", e);
+   char *n = strchr(buf, ':');
+   if (n == NULL)
+      return;
+   *n++ = 0;
+   char *pn = strchr(n, ':');
+   if (pn != NULL)
+      *pn++ = 0;
+   const int mode = strcmp(buf, "stall") == 0 ? NVRM_REC_INJ_STALL : strcmp(buf, "fake") == 0 ? NVRM_REC_INJ_FAKE
+                  : strcmp(buf, "reset") == 0 ? NVRM_REC_INJ_RESET : strcmp(buf, "mmu") == 0 ? NVRM_REC_INJ_MMU
+                  : NVRM_REC_INJ_NONE;
+   const long count = strtol(n, NULL, 10);
+   const char *me = getprogname();
+   if (mode == NVRM_REC_INJ_NONE || count <= 0 || me == NULL)
+      return;
+   if (pn != NULL && pn[0] != 0 ? strcmp(pn, me) != 0
+                                : (strcmp(me, "WindowServer") == 0 || strcmp(me, "loginwindow") == 0))
+      return;
+   nvrm_rec_inj.mode = mode;
+   nvrm_rec_inj.n = (unsigned)count;
+   fprintf(stderr, "nvrm: NVK_FAULT_INJECT: %s at flush %ld of the first graphics queue of %s\n", buf, count, me);
+}
+
+int
+nvrm_rec_inject_for_flush(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   pthread_once(&nvrm_rec_inj.once, rec_inject_parse);
+   if (nvrm_rec_inj.mode == NVRM_REC_INJ_NONE || !nvrm_rec_enabled())
+      return NVRM_REC_INJ_NONE;
+   if (ctx->ceOnly || ctx->engines == NVKMD_ENGINE_COPY)
+      return NVRM_REC_INJ_NONE;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   int mode = NVRM_REC_INJ_NONE;
+   if (nvrm_rec_inj.ctx == NULL)
+      nvrm_rec_inj.ctx = ctx;
+   if (nvrm_rec_inj.ctx == ctx && !nvrm_rec_inj.done && ++nvrm_rec_inj.count == nvrm_rec_inj.n) {
+      nvrm_rec_inj.done = true;
+      mode = nvrm_rec_inj.mode;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (mode != NVRM_REC_INJ_NONE) {
+      rec_stat_add(REC_ST_INJECTED, 1);
+      rec_note(nvkmd_nvrm_pdev(ctx->base.dev->pdev), NVRM_CN_INJECTED, 0, 0, 0, 0, NULL);
+      fprintf(stderr, "nvrm: NVK_FAULT_INJECT: injecting at flush %u (sequence %llu)\n", nvrm_rec_inj.n,
+              (unsigned long long)ctx->wSeq + 1);
+   }
+   return mode;
+}
+
+void
+nvrm_rec_inject_after_doorbell(struct nvkmd_nvrm_exec_ctx *ctx, int mode)
+{
+   if (mode == NVRM_REC_INJ_FAKE) {
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      nvkmd_nvrm_slots[ctx->slot1 - 1].injectFault = true;
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   } else if (mode == NVRM_REC_INJ_RESET) {
+      struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(ctx->base.dev->pdev);
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+      NV906F_CTRL_CMD_RESET_CHANNEL_PARAMS rp;
+      memset(&rp, 0, sizeof(rp));
+      rp.engineID = NV2080_ENGINE_TYPE_GRAPHICS;
+      rp.resetReason = NV906F_CTRL_CMD_RESET_CHANNEL_REASON_VERIF;
+      const NvU32 rc = nvRmApiControl(&rm, ctx->hChannel, NV906F_CTRL_CMD_RESET_CHANNEL, &rp, sizeof(rp));
+      fprintf(stderr, "nvrm: NVK_FAULT_INJECT: channel reset rc 0x%x\n", (unsigned)rc);
+   }
+}
+
+/* ── the export ──────────────────────────────────────────────────────────────────────────────────────────────────── */
+
+__attribute__((visibility("default"))) unsigned
+nvmtl_nvk_recover_stats_v1(uint64_t *out, unsigned n)
+{
+   if (out == NULL)
+      return 0;
+   const unsigned k = n < REC_ST_N ? n : REC_ST_N;
+   for (unsigned i = 0; i < k; i++)
+      out[i] = __atomic_load_n(&nvrm_rec_stats[i], __ATOMIC_RELAXED);
+   if (k > REC_ST_VERSION)
+      out[REC_ST_VERSION] = 1;
+   if (k > REC_ST_ENABLED)
+      out[REC_ST_ENABLED] = nvrm_rec_enabled();
+   if (k > REC_ST_KEXT)
+      out[REC_ST_KEXT] = (uint64_t)__atomic_load_n(&nvrm_rec_kext, __ATOMIC_ACQUIRE);
+   return k;
+}
diff --git a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_recover.h b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_recover.h
new file mode 100644
