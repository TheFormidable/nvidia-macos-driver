+cls(uint32_t xid, uint32_t changed, int32_t pm, uint32_t asked, uint32_t rc, uint32_t action)
+{
+   const struct nvrm_rec_inputs in = { xid, changed, pm, asked, rc, action };
+   return nvrm_rec_classify(&in);
+}
