+static void
+test_budget(void)
+{
+   int64_t s[NVRM_REC_MAX_REBUILDS] = { 0 };
+   const int64_t t = 1000000000000ll;
+   arm("budget: no stamp allows", nvrm_rec_budget_ok(s, t));
+   nvrm_rec_budget_push(s, t);
+   nvrm_rec_budget_push(s, t + 1000);
+   arm("budget: two inside the window allow a third", nvrm_rec_budget_ok(s, t + 2000));
+   nvrm_rec_budget_push(s, t + 2000);
+   arm("budget: three inside the window refuse", !nvrm_rec_budget_ok(s, t + 3000));
+   arm("budget: the oldest ageing out allows again", nvrm_rec_budget_ok(s, t + NVRM_REC_WINDOW_NS));
+   nvrm_rec_budget_push(s, t + NVRM_REC_WINDOW_NS);
+   bool replaced = false;
+   for (unsigned i = 0; i < NVRM_REC_MAX_REBUILDS; i++)
