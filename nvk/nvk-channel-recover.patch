+ * SPDX-License-Identifier: MIT
+ */
+/* nvkmd_nvrm_recover.h - the pure part of rebuilding a faulted or stalled channel in place.
+ *
+ * A GPU fault on one channel used to end the process's whole Vulkan device: the waiter saw the error notifier change
+ * (or a deadline pass) and returned VK_ERROR_DEVICE_LOST, which the Metal plugin turns into a lost Metal device and,
+ * in WindowServer, a lost session. RM tears down only the faulting channel group, so a new channel can usually be made
+ * beside it. nvkmd_nvrm_recover.c does that: it builds a new channel, frees the old one, moves the new one behind the
+ * same context (same semaphore page, same command ring), re-sends the channel-wide state, replays the flushes that had
+ * not started, and stores the sequence number of the one flush it drops into the semaphore from the CPU.
+ *
+ * This header holds every decision of that sequence that needs no RM and no clock: which losses are recoverable, the
+ * rebuild budget, the plan of what is dropped and what is replayed, the copy of the GPFIFO entries into the new ring,
+ * the channel a stalled wait is really blocked on, the dropped sequence ranges, and the order of the steps themselves
+ * (nvrm_rec_execute drives a table of operations that NVK fills with RM calls and the host test with fakes).
+ * Plain C: only <stdint.h>, <stdbool.h>, <string.h>; every function static inline. The host test is
+ * nvkmd_nvrm_recover_test.c beside this file (build line in its first comment). */
+#ifndef NVKMD_NVRM_RECOVER_H
+#define NVKMD_NVRM_RECOVER_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#define NVRM_REC_RING          64             /* ring slots of a context's command ring (== NVRM_CMD_SLOTS) */
+#define NVRM_REC_FIFO          0x8000u        /* GPFIFO entries of a channel, two dwords each */
+#define NVRM_REC_MAX_REBUILDS  3              /* rebuilds of one channel allowed inside the window */
+#define NVRM_REC_WINDOW_NS     30000000000ll
+#define NVRM_REC_DROPS         8              /* dropped sequence ranges remembered per channel slot */
+#define NVRM_REC_CHAIN         4              /* SEM_ACQUIRE hops followed to the channel that blocks a wait */
+#define NVRM_REC_ASLEEP_NS     360000000000ll /* awake time a channel's "GPU suspended" answers are believed for */
+
+/* The kind of loss. Only CHANNEL and STALL are rebuilt; every other kind ends as 2.9 ended, with its name logged. */
+enum nvrm_rec_kind { NVRM_LOSS_NONE = 0, NVRM_LOSS_CHANNEL = 1, NVRM_LOSS_STALL = 2, NVRM_LOSS_MEMORY = 3,
+                     NVRM_LOSS_GSP = 4, NVRM_LOSS_BUS = 5, NVRM_LOSS_RESUME = 6, NVRM_LOSS_UNKNOWN = 7 };
+/* Why a recovery ended. OK: rebuilt. Every other value: the 2.9 result was returned, for that reason. */
+enum nvrm_rec_why  { NVRM_WHY_OK = 0, NVRM_WHY_OFF = 1, NVRM_WHY_KIND = 2, NVRM_WHY_BUDGET = 3, NVRM_WHY_PLAN = 4,
+                     NVRM_WHY_BUILD = 5, NVRM_WHY_FREE = 6, NVRM_WHY_COPY_REFAULT = 7, NVRM_WHY_BUSY = 8,
+                     NVRM_WHY_DYING = 9, NVRM_WHY_SHAPE = 10, NVRM_WHY_BLOBS = 11, NVRM_WHY_ROOT_ALIVE = 12,
+                     NVRM_WHY_GAVE_UP_BEFORE = 13, NVRM_WHY_ASLEEP = 14 };
+/* REPLAY: drop the flush that was running, replay the rest. REPLAY_ALL: drop nothing (a copy-only context: copies are
+ * idempotent and carry state that later work needs). DROP_ALL: the channel faulted again inside the work an earlier
+ * rebuild replayed, so that work is the cause: drop everything in flight. */
+enum nvrm_rec_level { NVRM_REC_REPLAY = 0, NVRM_REC_REPLAY_ALL = 1, NVRM_REC_DROP_ALL = 2 };
+
+static inline const char *
+nvrm_rec_kind_name(unsigned k)
+{
+   static const char *const n[] = { "none", "channel", "stall", "memory", "gsp", "bus", "resume", "unknown" };
+   return k < sizeof(n) / sizeof(n[0]) ? n[k] : "?";
+}
+
+static inline const char *
+nvrm_rec_why_name(unsigned w)
+{
+   static const char *const n[] = { "ok", "recovery off", "kind not recoverable", "rebuild budget spent",
+                                    "ring bookkeeping inconsistent", "new channel could not be built",
+                                    "old channel could not be freed", "copy channel faulted in replayed work",
+                                    "another recovery is stuck", "channel is being destroyed",
+                                    "channel shape not rebuildable", "channel state not captured",
+                                    "the channel it waits on is still progressing", "gave up before",
+                                    "the GPU is suspended for a sleep or wake" };
+   return w < sizeof(n) / sizeof(n[0]) ? n[w] : "?";
+}
+
+/* ── classification ─────────────────────────────────────────────────────────────────────────────────────────────── */
+
+struct nvrm_rec_inputs {
+   uint32_t xid;         /* the error notifier's info32 when it changed, else 0 */
+   uint32_t changed;     /* the error notifier's status differs from the one the channel started with */
+   int32_t  pm;          /* -1 unknown (a kext without the channel note), else NVRM_CN_PM_* */
+   uint32_t actionAsked; /* 0: RM's recovery action was not asked */
+   uint32_t actionRc;    /* the NV_STATUS of that control */
+   uint32_t action;      /* its answer; 0 = no action needed */
+};
+
+#define NVRM_REC_PM_SUSPENDED      1u      /* NVRM_CN_PM_SUSPENDED: a system sleep or wake is under way */
+#define NVRM_REC_PM_LOST           2u      /* NVRM_CN_PM_LOST: the adapter did not come back from sleep */
+#define NVRM_REC_RC_GPU_IS_LOST    0x0Fu   /* NV_ERR_GPU_IS_LOST */
+#define NVRM_REC_RC_FULLCHIP_RESET 0x10u   /* NV_ERR_GPU_IN_FULLCHIP_RESET */
+#define NVRM_REC_RC_NOT_SUPPORTED  0x56u   /* NV_ERR_NOT_SUPPORTED */
+#define NVRM_REC_RC_RESET_REQUIRED 0x62u   /* NV_ERR_RESET_REQUIRED */
+
+/* In this order: a failed wake; the GPU off the bus; the firmware crashed or wants a reset; uncorrectable memory errors;
+ * RM answering anything unexpected; then the channel exceptions that end only the faulting channel group (graphics
+ * exception 13, MMU fault 31, PBDMA 32, copy engines (Xid 39-41, 70-72, 75-77, 85, 126-135), reset verification 43, fault during a context switch 44,
+ * preemptive removal 45, graphics class error 69, context switch timeout 109 - 109 is not in the open RM headers, it is
+ * what this port measured for a long compute dispatch). A changed notifier with any other Xid is UNKNOWN and is not
+ * rebuilt. Nothing changed and nothing reported: NONE, which the caller turns into STALL. An unknown power state (-1)
+ * and "not supported" for the action say nothing either way. */
+static inline enum nvrm_rec_kind
+nvrm_rec_classify(const struct nvrm_rec_inputs *in)
+{
+   const uint32_t x = in->xid;
+   if (in->pm >= 0 && (uint32_t)in->pm == NVRM_REC_PM_LOST)
+      return NVRM_LOSS_RESUME;
+   if ((in->actionAsked && in->actionRc == NVRM_REC_RC_GPU_IS_LOST) || x == 79)
+      return NVRM_LOSS_BUS;
+   if (x == 119 || x == 120 ||
+       (in->actionAsked && (in->actionRc == NVRM_REC_RC_RESET_REQUIRED || in->actionRc == NVRM_REC_RC_FULLCHIP_RESET)) ||
+       (in->actionAsked && in->actionRc == 0 && in->action != 0))
+      return NVRM_LOSS_GSP;
+   if (x == 48 || x == 94 || x == 95 || x == 140)
+      return NVRM_LOSS_MEMORY;
+   if (in->actionAsked && in->actionRc != 0 && in->actionRc != NVRM_REC_RC_NOT_SUPPORTED)
+      return NVRM_LOSS_UNKNOWN;
+   if (in->changed) {
+      switch (x) {
+      case 13: case 31: case 32: case 39: case 40: case 41: case 43: case 44: case 45: case 69: case 109:
+      case 70: case 71: case 72: case 75: case 76: case 77: case 85:        /* copy engines 3 to 9 */
+      case 126: case 127: case 128: case 129: case 130: case 131: case 132: case 133: case 134: case 135:  /* copy engines 10 to 19 */
+         return NVRM_LOSS_CHANNEL;
+      default:
+         return NVRM_LOSS_UNKNOWN;
+      }
+   }
+   return NVRM_LOSS_NONE;
+}
+
+/* A channel that stands still because the GPU is suspended for a system sleep or wake is not stalled: the kext stops
+ * every user channel and holds every RM call from the start of the suspend to the end of the resume, while the awake
+ * clock of the stall budget goes on running. So a stall (nothing changed in the error notifier) on a GPU the kext
+ * calls suspended is answered "look again", without asking RM anything (RM calls wait for the resume). *since is the
+ * awake time of the first such answer for this channel, 0 none; any other answer clears it, and so does progress:
+ * prog is the awake time the channel's semaphore was last seen to move, and a stamp older than that belongs to an
+ * earlier sleep (the channel ran after it, and the waits of that sleep ended without asking again), so the next sleep
+ * gets a stamp of its own. The answer is believed for NVRM_REC_ASLEEP_NS of awake time only: a GPU that stays
+ * suspended (a resume that never comes) must not keep a waiter looking forever at work that cannot finish, so after
+ * that the normal sequence runs, which then waits for the resume inside RM as it always did. That is 360 s because an
+ * Intel Mac's own sleep and wake watchdogs (180 s each) end any sleep that takes longer, so it is never reached by a
+ * sleep the machine survives; the kext's own bounded waits in the suspend alone come to 17 s, besides the copy of the
+ * preserved VRAM out and back. An unknown power state (-1: an older kext) is never "suspended". */
+static inline bool
+nvrm_rec_asleep(int32_t pm, uint32_t changed, int64_t now, int64_t prog, int64_t *since)
+{
+   if (pm < 0 || (uint32_t)pm != NVRM_REC_PM_SUSPENDED || changed) {
+      *since = 0;
+      return false;
+   }
+   if (*since == 0 || prog >= *since)
+      *since = now != 0 ? now : 1;
+   return now - *since < NVRM_REC_ASLEEP_NS;
+}
+
+/* A stalled wait's root R (another channel) counts as still moving when its semaphore was last seen to change less than
+ * a quarter of the budget ago. progNs is the time of the look that saw the change, not of the change: a root nobody
+ * CPU-waits on is looked at only by the waiter's own kick (at half the budget) and its stall check (at the full one),
+ * so a change made before the kick is stamped by the kick and is half a budget old at the check, give or take one
+ * wait round (2 ms). A threshold of half a budget would make that a coin flip; a change after the kick is stamped by
+ * the check itself (age 0). */
+static inline bool
+nvrm_rec_root_alive(int64_t now, int64_t progNs, int64_t budget)
+{
+   return now - progNs < budget / 4;
+}
+
+/* ── the rebuild budget: at most NVRM_REC_MAX_REBUILDS inside NVRM_REC_WINDOW_NS; a stamp of 0 is an unused one ─── */
+
+static inline bool
+nvrm_rec_budget_ok(const int64_t stamps[NVRM_REC_MAX_REBUILDS], int64_t now)
+{
+   unsigned recent = 0;
+   for (unsigned i = 0; i < NVRM_REC_MAX_REBUILDS; i++)
+      if (stamps[i] != 0 && now - stamps[i] < NVRM_REC_WINDOW_NS)
+         recent++;
+   return recent < NVRM_REC_MAX_REBUILDS;
+}
+
+static inline void
+nvrm_rec_budget_push(int64_t stamps[NVRM_REC_MAX_REBUILDS], int64_t now)
+{
+   unsigned oldest = 0;
+   for (unsigned i = 0; i < NVRM_REC_MAX_REBUILDS; i++) {
+      if (stamps[i] == 0) {
+         oldest = i;
+         break;
+      }
+      if (stamps[i] < stamps[oldest])
+         oldest = i;
+   }
+   stamps[oldest] = now != 0 ? now : 1;
+}
+
+/* ── the plan ────────────────────────────────────────────────────────────────────────────────────────────────────── */
+
+/* A context's ring bookkeeping, copied under its mutex. A flush n (its sequence number) that is still in flight has
+ * exactly one ring slot i with slotSeq[i] == n: a slot is reused only after the semaphore passed its flush. Its GPFIFO
+ * entries are [slotBeg[i], slotPut[i]). Entries written after the last doorbell ([subPut, gpPut)) belong to the flush
+ * being built and were never handed to the GPU. */
+struct nvrm_rec_ring {
+   uint64_t slotSeq[NVRM_REC_RING];   /* sequence number whose release ends each ring slot, 0 = unused */
+   uint64_t slotBeg[NVRM_REC_RING];   /* GPFIFO index of that flush's first entry */
+   uint64_t slotPut[NVRM_REC_RING];   /* GPFIFO index after its last entry */
+   uint64_t subPut;                   /* GPPut at the last doorbell */
+   uint64_t gpPut;                    /* where the next entry goes */
+   uint64_t wSeq;                     /* F: the last flushed sequence number */
+};
+
+struct nvrm_rec_plan {
+   uint64_t S, F;                     /* the semaphore after the old channel is gone, and the last flushed number */
+   uint64_t dropLo, dropHi;           /* dropped flushes, inclusive; dropLo > dropHi = nothing dropped */
+   uint64_t keepLo, keepHi;           /* replayed flushes, inclusive; keepLo > keepHi = none */
+   uint32_t oldBegin;                 /* old GPFIFO index of the first entry carried into the new ring */
+   uint32_t nCarry;                   /* entries carried: the replayed flushes', then the ones never handed over */
+   uint32_t prologue;                 /* 0 or 1: one entry before them that re-sends the channel-wide state */
+   uint32_t newSubPut, newGpPut;      /* the new ring's GPPut to ring now, and where the next entry goes */
+};
+
+static inline uint32_t
+nvrm_rec_fifo_dist(uint64_t from, uint64_t to)
+{
+   return (uint32_t)((to + NVRM_REC_FIFO - (from % NVRM_REC_FIFO)) % NVRM_REC_FIFO);
+}
+
+/* 0 = a plan; -1 = the bookkeeping is not what a plan needs (nothing may be changed: the caller gives up). S is the
+ * semaphore's value; a value above F (the GPU never writes one) is refused. */
+static inline int
+nvrm_rec_plan(const struct nvrm_rec_ring *r, uint64_t S, enum nvrm_rec_level lv, bool havePrologue,
+              struct nvrm_rec_plan *p)
+{
+   memset(p, 0, sizeof(*p));
+   const uint64_t F = r->wSeq;
+   if (S > F || r->gpPut >= NVRM_REC_FIFO || r->subPut >= NVRM_REC_FIFO)
+      return -1;
+   const uint64_t first = lv == NVRM_REC_REPLAY ? S + 2 : lv == NVRM_REC_REPLAY_ALL ? S + 1 : F + 1;
+   p->S = S;
+   p->F = F;
+   p->dropLo = S + 1;
+   p->dropHi = (first - 1 < F ? first - 1 : F);
+   p->keepLo = first;
+   p->keepHi = F;
+   p->prologue = havePrologue ? 1u : 0u;
+   if (p->dropLo > p->dropHi) {   /* normalised "nothing dropped" */
+      p->dropLo = 1;
+      p->dropHi = 0;
+   }
+   uint64_t begin = r->subPut;
+   if (first <= F) {
+      unsigned idx = NVRM_REC_RING, prev = NVRM_REC_RING;
+      for (uint64_t n = first; n <= F; n++) {
+         unsigned hit = NVRM_REC_RING, count = 0;
+         for (unsigned i = 0; i < NVRM_REC_RING; i++)
+            if (r->slotSeq[i] == n) {
+               hit = i;
+               count++;
+            }
+         if (count != 1)
+            return -1;                                        /* missing or duplicate record */
+         if (r->slotBeg[hit] >= NVRM_REC_FIFO || r->slotPut[hit] >= NVRM_REC_FIFO)
+            return -1;
+         if (prev != NVRM_REC_RING) {
+            if (hit != (prev + 1) % NVRM_REC_RING || r->slotBeg[hit] != r->slotPut[prev])
+               return -1;                                     /* not consecutive, or a gap between two flushes */
+         } else {
+            idx = hit;
+         }
+         prev = hit;
+      }
+      if (r->slotPut[prev] != r->subPut)
+         return -1;                                           /* the last flush is not the last doorbell */
+      begin = r->slotBeg[idx];
+   }
+   p->oldBegin = (uint32_t)begin;
+   p->nCarry = nvrm_rec_fifo_dist(begin, r->gpPut);
+   if (p->prologue + p->nCarry > NVRM_REC_FIFO - 2)
+      return -1;
+   p->newSubPut = nvrm_rec_fifo_dist(begin, r->subPut) + p->prologue;
+   p->newGpPut = p->nCarry + p->prologue;
+   if (p->newSubPut > p->newGpPut)
+      return -1;                                              /* the doorbell would hand over unflushed entries */
+   return 0;
+}
+
+/* Writes the new GPFIFO (2 * NVRM_REC_FIFO dwords) and the ring as the context must see it afterwards. The new GPFIFO
+ * is the new channel's own memory, not yet seen by any GPU; the old one is only read. */
+static inline void
+nvrm_rec_fill(const struct nvrm_rec_ring *r, const struct nvrm_rec_plan *p, const uint32_t *oldFifo,
+              uint32_t *newFifo, const uint32_t prologueEntry[2], struct nvrm_rec_ring *out)
+{
+   memset(out, 0, sizeof(*out));
+   if (p->prologue) {
+      newFifo[0] = prologueEntry[0];
+      newFifo[1] = prologueEntry[1];
+   }
+   for (uint32_t k = 0; k < p->nCarry; k++) {
+      const uint32_t from = (p->oldBegin + k) % NVRM_REC_FIFO, to = p->prologue + k;
+      newFifo[2 * to] = oldFifo[2 * from];
+      newFifo[2 * to + 1] = oldFifo[2 * from + 1];
+   }
+   for (unsigned i = 0; i < NVRM_REC_RING; i++) {
+      const uint64_t n = r->slotSeq[i];
+      if (n == 0 || n < p->keepLo || n > p->keepHi)
+         continue;
+      out->slotSeq[i] = n;
+      out->slotBeg[i] = nvrm_rec_fifo_dist(p->oldBegin, r->slotBeg[i]) + p->prologue;
+      out->slotPut[i] = nvrm_rec_fifo_dist(p->oldBegin, r->slotPut[i]) + p->prologue;
+   }
+   out->subPut = p->newSubPut;
+   out->gpPut = p->newGpPut;
+   out->wSeq = r->wSeq;
+}
+
+/* ── the channel a stalled wait is really blocked on ─────────────────────────────────────────────────────────────── */
+
+struct nvrm_rec_view {          /* one channel slot, as seen under the slot table's mutex */
+   bool valid, changed;         /* registered on the same device as the waited channel; its error notifier changed */
+   uint64_t sem, flushed, semVA, acqVA, acqSeq;
+};
+
+/* From `start`, follow the last semaphore acquire each channel emitted while its target has not reached the value:
+ * at most NVRM_REC_CHAIN hops; a changed notifier, a satisfied or unknown target, another device's channel or a cycle
+ * ends the walk where it is. */
+static inline uint32_t
+nvrm_rec_root(const struct nvrm_rec_view v[], uint32_t n, uint32_t start)
+{
+   uint32_t cur = start, seen[NVRM_REC_CHAIN + 1];
+   unsigned nseen = 0;
+   if (start >= n)
+      return start;
+   seen[nseen++] = cur;
+   for (unsigned hop = 0; hop < NVRM_REC_CHAIN; hop++) {
+      const struct nvrm_rec_view *c = &v[cur];
+      if (c->changed || c->acqVA == 0)
+         break;
+      uint32_t t = n;
+      for (uint32_t i = 0; i < n; i++)
+         if (i != cur && v[i].valid && v[i].semVA == c->acqVA) {
+            t = i;
+            break;
+         }
+      if (t == n || v[t].sem >= c->acqSeq)
+         break;
+      bool cycle = false;
+      for (unsigned j = 0; j < nseen; j++)
+         cycle = cycle || seen[j] == t;
+      if (cycle)
+         break;
+      cur = t;
+      seen[nseen++] = cur;
+   }
+   return cur;
+}
+
+/* ── dropped sequence ranges: a ring, the newest wins ───────────────────────────────────────────────────────────── */
+
+struct nvrm_rec_drops {
+   uint64_t lo[NVRM_REC_DROPS], hi[NVRM_REC_DROPS];
+   uint32_t n;                  /* ranges ever added; the last NVRM_REC_DROPS are kept */
+};
+
+static inline void
+nvrm_rec_drops_add(struct nvrm_rec_drops *d, uint64_t lo, uint64_t hi)
+{
+   if (lo > hi)
+      return;
+   const uint32_t i = d->n % NVRM_REC_DROPS;
+   d->lo[i] = lo;
+   d->hi[i] = hi;
+   d->n++;
+}
+
+static inline bool
+nvrm_rec_drops_has(const struct nvrm_rec_drops *d, uint64_t seq)
+{
+   const uint32_t k = d->n < NVRM_REC_DROPS ? d->n : NVRM_REC_DROPS;
+   for (uint32_t i = 0; i < k; i++)
+      if (seq >= d->lo[i] && seq <= d->hi[i])
+         return true;
+   return false;
+}
+
+/* ── the order of the rebuild ───────────────────────────────────────────────────────────────────────────────────── */
+
+struct nvrm_rec_state {         /* read under the context's mutex before the sequence starts */
+   struct nvrm_rec_ring ring;
+   bool copyOnly, havePrologue;
+   uint64_t replayedThrough;    /* F of the last rebuild: a fault below it is a fault in replayed work */
+   int64_t stamps[NVRM_REC_MAX_REBUILDS], now;
+   int64_t progNs;              /* awake time the channel's semaphore was last seen to move (nvrm_rec_asleep) */
+};
+
+struct nvrm_rec_ops {
+   void     (*inputs)(void *u, struct nvrm_rec_inputs *in);   /* the notifier and the kext's power state */
+   void     (*action)(void *u, struct nvrm_rec_inputs *in);   /* RM's recovery action (an RM call) */
+   uint64_t (*read_sem)(void *u);
+   int      (*build)(void *u);                                /* the new channel and the prologue buffer; 0 = ok */
+   void     (*discard)(void *u);                              /* destroy what build made */
+   int      (*free_old)(void *u);                             /* 0 = the old channel is gone */
+   /* fill the new GPFIFO from the snapshot (nvrm_rec_fill), move the new channel in, store the dropped value */
+   void     (*adopt)(void *u, const struct nvrm_rec_ring *ring, const struct nvrm_rec_plan *p);
+   void     (*start)(void *u, const struct nvrm_rec_plan *p); /* GPPut and the doorbell */
+};
+
+/* The inputs, then: a stall on a suspended GPU is ASLEEP (nvrm_rec_asleep; *asleepSince is the channel's stamp, kept
+ * by the caller), which asks RM nothing, builds nothing and is not final: the waiter looks again. Otherwise RM's
+ * action, classify, check the budget, choose the level, plan, build, free the old channel, plan again with the final
+ * semaphore, adopt, start. A refusal before free_old changes nothing; a failed build cleans up after itself; a failed
+ * free_old is followed by discard and nothing else. After free_old nothing can fail: the plan that held for the
+ * semaphore before it holds for any later value (fewer flushes remain), and adopt and start are memory writes.
+ * *kind and *level are set as far as the sequence got; *plan is the plan that was adopted. */
+static inline enum nvrm_rec_why
+nvrm_rec_execute(const struct nvrm_rec_ops *ops, void *u, const struct nvrm_rec_state *st, int64_t *asleepSince,
+                 enum nvrm_rec_kind *kind, enum nvrm_rec_level *level, struct nvrm_rec_plan *plan)
+{
+   struct nvrm_rec_inputs in;
+   memset(&in, 0, sizeof(in));
+   in.pm = -1;
+   ops->inputs(u, &in);
+   *kind = NVRM_LOSS_NONE;
+   *level = NVRM_REC_REPLAY;
+   if (nvrm_rec_asleep(in.pm, in.changed, st->now, st->progNs, asleepSince))
+      return NVRM_WHY_ASLEEP;
+   ops->action(u, &in);
+   enum nvrm_rec_kind k = nvrm_rec_classify(&in);
+   if (k == NVRM_LOSS_NONE && !in.changed)
+      k = NVRM_LOSS_STALL;
+   *kind = k;
+   *level = NVRM_REC_REPLAY;
+   if (k != NVRM_LOSS_CHANNEL && k != NVRM_LOSS_STALL)
+      return NVRM_WHY_KIND;
+   if (!nvrm_rec_budget_ok(st->stamps, st->now))
+      return NVRM_WHY_BUDGET;
+   const uint64_t S0 = ops->read_sem(u);
+   enum nvrm_rec_level lv;
+   if (st->copyOnly) {
+      if (S0 < st->replayedThrough)
+         return NVRM_WHY_COPY_REFAULT;
+      lv = NVRM_REC_REPLAY_ALL;
+   } else {
+      lv = S0 < st->replayedThrough ? NVRM_REC_DROP_ALL : NVRM_REC_REPLAY;
+   }
+   *level = lv;
+   struct nvrm_rec_plan pre;
+   if (nvrm_rec_plan(&st->ring, S0, lv, st->havePrologue, &pre) != 0)
+      return NVRM_WHY_PLAN;
+   if (ops->build(u) != 0)
+      return NVRM_WHY_BUILD;
+   if (ops->free_old(u) != 0) {
+      ops->discard(u);
+      return NVRM_WHY_FREE;
+   }
+   uint64_t S = ops->read_sem(u);
+   if (S < S0 || S > st->ring.wSeq)
+      S = S0;   /* the old channel is gone: a value outside [S0, F] is not the GPU's; the plan for S0 is still sound */
+   if (nvrm_rec_plan(&st->ring, S, lv, st->havePrologue, plan) != 0)
+      *plan = pre;   /* cannot happen (a plan for S0 holds for every later S); keep the checked one */
+   ops->adopt(u, &st->ring, plan);
+   ops->start(u, plan);
+   return NVRM_WHY_OK;
+}
