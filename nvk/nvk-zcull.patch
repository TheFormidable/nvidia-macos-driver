    pdev->base.dev_info.cls_vdec = 0;
    pdev->base.dev_info.has_video = false;
    pdev->base.dev_info.has_transfer_queue = false;
-   pdev->base.dev_info.has_zcull_info = false;
+   nvkmd_nvrm_pdev_zcull(pdev, &rm);
 
