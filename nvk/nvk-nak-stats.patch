+        let i = &s.info;
+        let instrs = u64::from(i.num_instrs);
+        let gprs = max(4, u32::from(i.num_gprs) + sm.hw_reserved_gprs());
+        eprintln!(
+            "{}",
+            nak_stats_line(
+                stage,
+                nak.sm,
+                &nir.info.source_blake3[..],
+                &[
+                    ("instrs", instrs),
+                    ("instrs_warp", instrs.saturating_sub(uniform)),
+                    ("instrs_uniform", uniform),
+                    ("gprs", u64::from(gprs)),
+                    ("warps_per_sm", u64::from(i.max_warps_per_sm)),
+                    ("static_cycles", i.num_static_cycles),
+                    ("spills_to_mem", u64::from(i.num_spills_to_mem)),
+                    ("fills_from_mem", u64::from(i.num_fills_from_mem)),
+                    ("spills_to_reg", u64::from(i.num_spills_to_reg)),
+                    ("fills_from_reg", u64::from(i.num_fills_from_reg)),
+                    ("slm", u64::from(i.slm_size)),
+                ],
+            )
+        );
+    }
