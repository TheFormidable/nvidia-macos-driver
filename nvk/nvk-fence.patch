+/* ═══ THE SURFACE FENCE (nvrm_fence_abi.h, kext selector 12) ═══════════════════════════════════════════════════════
+ * 2.9 told the reader of an IOSurface that its writer had finished with marks and tags that only a clock could end:
+ * a reader polled for up to 10 ms, NVAccel waited for up to 100 ms, and a writer that died left its mark to time out.
+ * NVRM.kext now keeps those holds itself, per surface, and reads their completion from the writing channel's own
+ * semaphore page, so a reader sleeps exactly until the work is done or its writer is gone. NVK's part:
+ *   - register each channel's semaphore page and error notifier with the kernel (CHAN_ADD, then CHAN_VERIFY: the kernel
+ *     proves that its view of the page follows later writes before any wait trusts it), and delete the registration
+ *     (CHAN_DEL) before either page is freed;
+ *   - store the value of each flush at NVRM_FENCE_SEM_FLUSHED_OFF before the GPU can see the work, so that the kernel
+ *     can tell "the writer's GPU work is still running" from "the writer is stuck";
+ *   - carry the plugin's requests (nvmtl_nvk_fence_v1) and turn a VkFence into (channel, value) for ARM;
+ *   - give the event wait a kernel sleep for a channel that raises no event of its own (WAIT_SEQ).
+ * ONE CONNECTION FOR THE PROCESS. The kernel names the owner of channels and holds by the connection a request arrives
+ * on, and arms a hold only on a channel of the same owner. So every request of the process goes through one control
+ * connection, opened for this alone at the first request and never closed: a device's own connection is closed with its
+ * device and may then be pooled and handed to a later open, which would strand the channels registered under it. When
+ * the process exits the connection closes and the kernel ends everything it owned.
+ * EVERY FAILURE COSTS ONLY THE FENCE. A kext without selector 12 (2.9) fails the first request: the fence is absent for
+ * the life of the process, nothing more is asked and nothing is printed (NVK_DIAG=1 says it). A kext whose fence is off
+ * (nvrmfence=0) answers NVRM_FENCE_ST_OFF.
+ * A channel the kernel will not watch keeps kchan 0 and runs as before; while such a channel exists OPEN answers
+ * NVRM_FENCE_ST_MAP, and the plugin covers the process's surfaces with the 2.9 marks and tags (a hold whose completion
+ * the kernel cannot see would run into its time bound and count against the process). */
+static int nvrm_fence_fd = -1;    /* the fence connection; written once, before nvrm_fence_have becomes 1 */
+static int nvrm_fence_have;       /* 0 not asked yet, 1 the kext answers selector 12, -1 it does not (for good) */
+static pthread_mutex_t nvrm_fence_open_mtx = PTHREAD_MUTEX_INITIALIZER;   /* opening the connection, nothing else */
+/* After a WAIT_SEQ that did not sleep, that channel is polled for this long before the kernel is asked again: a channel
+ * the kernel has judged it cannot follow (its interrupts kept missing the slice) is answered PENDING at once, and
+ * asking at every polling step would add a system call to each. */
+#define NVRM_FENCE_SEQ_QUIET_NS 50000000LL
+
+static void
+nvrm_fence_req(struct NVRMFenceReq *r, uint32_t op, uint32_t flags)
+{
+   memset(r, 0, sizeof(*r));   /* every field the op does not read is zero */
+   r->version = NVRM_FENCE_ABI_VERSION;
+   r->op = op;
+   r->flags = flags;
+}
+
+/* One line per process, for the first thing that keeps the fence from a channel or from the process when the kext
+ * has a fence. */
+static void
+nvrm_fence_say(const char *what, unsigned status)
+{
+   static int said;
+   if (__atomic_exchange_n(&said, 1, __ATOMIC_RELAXED) == 0)
+      fprintf(stderr, "nvrm: surface fence: %s (status 0x%x) - surfaces use the 2.9 marks where it applies\n",
+              what, status);
+}
+
+/* Sends r on the fence connection, opening it at the first request. true: the kext answered, r->status is its answer,
+ * and the op's output fields may be read when that is NVRM_FENCE_ST_OK. false: there is no fence in this process;
+ * r->status is NVRM_FENCE_ST_OFF. */
+static bool
+nvrm_fence_call(struct NVRMFenceReq *r)
+{
+   int have = __atomic_load_n(&nvrm_fence_have, __ATOMIC_ACQUIRE);
+   if (have == 0) {
+      pthread_mutex_lock(&nvrm_fence_open_mtx);
+      have = __atomic_load_n(&nvrm_fence_have, __ATOMIC_ACQUIRE);   /* another thread may have opened it, or lost it */
+      if (have == 0) {
+         struct NVRMFenceReq q;
+         nvrm_fence_req(&q, NVRM_FENCE_OP_QUERY, 0);
+         const int fd = NVRM_OPEN(NVRM_CTL_NODE_NAME);
+         if (fd >= 0 && nvrm_xnu_fence(fd, &q) == 0) {
+            __atomic_store_n(&nvrm_fence_fd, fd, __ATOMIC_RELAXED);
+            have = 1;
+         } else {
+            if (fd >= 0)
+               NVRM_CLOSE(fd);
+            have = -1;
+            /* A kext older than the fence (2.9, still loaded after an update until the restart) is not a fault, and
+             * a program on a healthy GPU prints nothing: that case is said only when the diagnostics are on. */
+            if (fd < 0)
+               nvrm_fence_say("no connection to the kext", 0);
+            else if (nvkmd_nvrm_diag_on())
+               nvrm_fence_say("the kext has none", 0);
+         }
+         __atomic_store_n(&nvrm_fence_have, have, __ATOMIC_RELEASE);
+      }
+      pthread_mutex_unlock(&nvrm_fence_open_mtx);
+   }
+   if (have > 0 && nvrm_xnu_fence(__atomic_load_n(&nvrm_fence_fd, __ATOMIC_RELAXED), r) == 0)
+      return true;
+   if (have > 0) {   /* the method answered before and now does not: stop asking */
+      __atomic_store_n(&nvrm_fence_have, -1, __ATOMIC_RELEASE);
+      nvrm_fence_say("the kext stopped answering", 0);
+   }
+   r->status = NVRM_FENCE_ST_OFF;
+   return false;
+}
+
+/* CHAN_DEL. Sent even after the fence was found gone: a handle exists only because the method answered, and the kernel
+ * keeps both pages mapped until the channel is deleted or the process exits. */
+static void
+nvrm_fence_chan_del(uint32_t handle)
+{
+   const int fd = __atomic_load_n(&nvrm_fence_fd, __ATOMIC_RELAXED);
+   if (handle == 0 || fd < 0)
+      return;
+   struct NVRMFenceReq r;
+   nvrm_fence_req(&r, NVRM_FENCE_OP_CHAN_DEL, 0);
+   r.u.chan.chan = handle;
+   (void)nvrm_xnu_fence(fd, &r);
+}
+
+/* The kernel handle of a slot's channel, cleared there: the caller sends CHAN_DEL for it after unlocking. This is the
+ * only way a handle leaves a slot, so exactly one CHAN_DEL is sent per registration. Caller holds nvkmd_nvrm_gsub_mtx. */
+static uint32_t
+nvrm_fence_chan_take(struct nvkmd_nvrm_slot *s)
+{
+   const uint32_t handle = s->kchan;
+   s->kchan = 0;
+   return handle;
+}
+
+static bool
+nvrm_fence_notifier_ok(uintptr_t errVA)
+{
+   return (errVA & 0xf) == 0 && (errVA & 0xfff) <= 0x1000 - 16;   /* 16 bytes, 16-aligned, inside one page */
+}
+
+/* Registers a channel that has just taken its slot (nvrm_gsub_register): on success the slot's kchan is the kernel's
+ * handle; on any failure kchan stays 0 and nothing stays registered (a refused CHAN_VERIFY is followed by CHAN_DEL).
+ * The channel itself is not affected either way. */
+static void
+nvrm_fence_chan_add(struct nvkmd_nvrm_exec_ctx *ctx, const NvNotification *errN, unsigned errBase)
+{
+   volatile uint64_t *page = ctx->sem->map;
+   const uintptr_t semVA = (uintptr_t)ctx->sem->map, errVA = (uintptr_t)errN;
+   if (__atomic_load_n(&nvrm_fence_have, __ATOMIC_ACQUIRE) < 0)
+      return;
+   if ((semVA & 0xfff) != 0 || !nvrm_fence_notifier_ok(errVA)) {
+      nvrm_fence_say("a channel's pages are not laid out as the kernel needs", 0);
+      return;
+   }
+   /* never 0, and its complement (what CHAN_VERIFY looks for) is neither 0 nor the probe itself */
+   static uint32_t serial;
+   const uint64_t probe = (uint64_t)(uint32_t)getpid() << 32 | (__atomic_add_fetch(&serial, 1, __ATOMIC_RELAXED) | 1u);
+   __atomic_store_n(&page[NVRM_FENCE_SEM_PROBE_OFF / 8], probe, __ATOMIC_SEQ_CST);
+   struct NVRMFenceReq r;
+   nvrm_fence_req(&r, NVRM_FENCE_OP_CHAN_ADD, ctx->ceOnly ? NVRM_FENCE_F_CHAN_CE : 0);
+   r.u.chan.semVA = semVA;
+   r.u.chan.errVA = errVA;
+   r.u.chan.probe = probe;
+   r.u.chan.errBase = errBase;
+   if (!nvrm_fence_call(&r))
+      return;
+   if (r.status != NVRM_FENCE_ST_OK || r.u.chan.chan == 0) {
+      if (r.status != NVRM_FENCE_ST_OFF)   /* off on purpose (nvrmfence=0) is not worth a line */
+         nvrm_fence_say("the kernel would not watch a channel", r.status);
+      return;
+   }
+   const uint32_t handle = r.u.chan.chan;
+   /* a new value: the kernel reads it through the mapping CHAN_ADD made, which shows that mapping follows later writes */
+   __atomic_store_n(&page[NVRM_FENCE_SEM_PROBE_OFF / 8], ~probe, __ATOMIC_SEQ_CST);
+   nvrm_fence_req(&r, NVRM_FENCE_OP_CHAN_VERIFY, 0);
+   r.u.chan.chan = handle;
+   r.u.chan.probe = ~probe;
+   if (!nvrm_fence_call(&r) || r.status != NVRM_FENCE_ST_OK) {
+      nvrm_fence_chan_del(handle);
+      nvrm_fence_say("the kernel's view of a channel's semaphore page did not follow it", r.status);
+      return;
+   }
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[ctx->slot1 - 1];
+   const bool mine = s->ctx == ctx;
+   if (mine) {
+      s->kchan = handle;
+      s->kseqQuiet = 0;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (!mine)
+      nvrm_fence_chan_del(handle);
+}
+
+/* The event wait's seam for a channel that raises no event of its own, such as a copy-engine channel (the `wait` of
+ * struct nvrm_evw_ops with fd < 0, nvrm_evwait.h). The kernel sleeps on that channel's semaphore (WAIT_SEQ) until it
+ * reaches the value waited for; the first channel of the wait that is short of its value and that the kernel watches is
+ * the one slept on, and the caller checks every channel again afterwards. timeout_us is the longest the round allows
+ * (2 ms, or what is left before an application's deadline, in every mode: nvrm_evw_nvk_left_us). The kernel counts in
+ * milliseconds, so it is given the whole milliseconds of that, never more; a round with less than one millisecond left
+ * is polled.
+ * Returns 0 with WOKEN (the value was reached) or TIMEOUT (the kernel slept the whole time); -1 when the kernel did not
+ * sleep: no watched channel is pending, the kernel will not sleep on that channel (it judged that channel's interrupts
+ * unreliable to follow: PENDING), the channel faulted or is gone (DEAD: the caller's own health check then reports the fault), the sleep
+ * was interrupted, the fence is off, or the answer does not hold up (a value the semaphore has not reached, a "slept"
+ * shorter than half the time). The round then takes one step of the 2.9 polling, and that channel is polled, not asked,
+ * for NVRM_FENCE_SEQ_QUIET_NS. So every 0 is a real sleep or a real completion, and the loop cannot spin in the kernel. */
+static int
+nvrm_fence_wait_first(unsigned n, const uint32_t *slot, const uint32_t *gen, const uint64_t *want,
+                      uint32_t timeout_us, uint64_t *out)
+{
+   const uint32_t whole_ms = timeout_us / 1000;   /* rounded down: the sleep must end inside the round's time */
+   const uint32_t timeout_ms = whole_ms > NVRM_FENCE_SEQ_MAX_MS ? NVRM_FENCE_SEQ_MAX_MS : whole_ms;
+   if (timeout_ms == 0 || __atomic_load_n(&nvrm_fence_have, __ATOMIC_ACQUIRE) <= 0)
+      return -1;
+   const int64_t now = os_time_get_nano();
+   uint32_t handle = 0, at = 0, g = 0;
+   uint64_t seq = 0;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned h = 0; h < n && handle == 0; h++) {
+      const struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[slot[h]];
+      if (s->ctx == NULL || s->gen != gen[h] || __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) >= want[h])
+         continue;
+      if (s->kchan != 0 && now >= s->kseqQuiet) {
+         handle = s->kchan;
+         seq = want[h];
+         at = slot[h];
+         g = gen[h];
+      }
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (handle == 0)
+      return -1;
+   struct NVRMFenceReq r;
+   nvrm_fence_req(&r, NVRM_FENCE_OP_WAIT_SEQ, 0);
+   r.u.wait.id = handle;
+   r.u.wait.seq = seq;
+   r.u.wait.timeoutMs = timeout_ms;
+   const bool answered = nvrm_fence_call(&r) && r.status == NVRM_FENCE_ST_OK;
+   const int64_t took = os_time_get_nano() - now;
+   int ret = -1;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[at];
+   const bool live = s->ctx != NULL && s->gen == g;   /* not retired meanwhile (retiring idles the channel first) */
+   if (answered && (r.u.wait.result == NVRM_FENCE_R_READY || r.u.wait.result == NVRM_FENCE_R_NONE)) {
+      /* reached: believed only when the semaphore says so too */
+      if (!live || __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) >= seq) {
+         *out = nvrm_evw_pack(0, NVRM_EVW_R_WOKEN);
+         ret = 0;
+      }
+   } else if (answered && r.u.wait.result == NVRM_FENCE_R_BUDGET && took >= (int64_t)timeout_ms * 500000) {
+      *out = nvrm_evw_pack(0, NVRM_EVW_R_TIMEOUT);
+      ret = 0;
+   }
+   if (ret != 0 && live && s->kchan == handle)
+      s->kseqQuiet = os_time_get_nano() + NVRM_FENCE_SEQ_QUIET_NS;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return ret;
+}
+
 /* b73 SLEEP ON THE GPU'S COMPLETION EVENT. NVK ends every submission with NON_STALL_INTERRUPT after its semaphore
  * release; RM's event for it reaches the device's osEvent connection (one per VkDevice, and GPU-wide: every graphics
  * completion posts it), and the kext's selector 6 sleeps until that event's count moves.
@@ -297,14 +541,24 @@ nvrm_evw_nvk_pending(void *p, int *fd)
