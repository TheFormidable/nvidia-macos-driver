+/* The surface fence's ARM (nvkmd_nvrm_fence): the one GPU completion a binary sync (a VkFence's payload) stands for.
+ * 0 = complete: nothing pending and signalled (a channel that was idled and retired counts, the reap sees to it);
+ * 1 = exactly one submission pending, the channel's (*slot, *gen) and the value *seq its semaphore will reach;
+ * -1 = anything else (a timeline, a foreign sync type, not submitted yet, several entries): no target. */
+int
+nvkmd_nvrm_sync_fence_target(struct vk_sync *vs, uint32_t *slot, uint32_t *gen, uint64_t *seq)
+{
+   struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(vs);
+   if (s == NULL || !nvrm_gsub_is_binary(s))
+      return -1;
+   nvrm_gsub_reap(s);
+   if (s->npend == 0)
+      return s->value >= 1 ? 0 : -1;
+   if (s->npend != 1)
+      return -1;
+   *slot = s->pend[0].slot;
+   *gen = s->pend[0].gen;
+   *seq = s->pend[0].seq;
+   return 1;
+}
