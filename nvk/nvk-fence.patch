+/* The surface fence (nvrm_fence_abi.h): one request through selector 12, the same struct in and out. Returns 0 when the
+ * kext took the struct and gave all of it back (its answer is then r->status), -1 when there is no connection or the
+ * kext has no such method (a 2.9 kext answers kIOReturnBadArgument); r is then left as the caller built it. */
+int nvrm_xnu_fence(int fd, struct NVRMFenceReq *r)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return -1;
+    struct NVRMFenceReq out; size_t outSize = sizeof out;
+    memset(&out, 0, sizeof out);
+    kern_return_t kr = IOConnectCallStructMethod(conn, NVRM_FENCE_SELECTOR, r, sizeof *r, &out, &outSize);
+    if (kr != KERN_SUCCESS || outSize != sizeof out) return -1;
+    *r = out;
+    return 0;
+}
