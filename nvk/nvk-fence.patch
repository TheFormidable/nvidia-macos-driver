+/* Surface fence: see nvkmd_nvrm.h. The rebuilt channel keeps its semaphore page and its kernel handle; only the error
+ * notifier the kernel reads faults from changes. Refused, or a notifier the kernel cannot take: the registration goes
+ * (CHAN_DEL, kchan 0), which makes OPEN answer NVRM_FENCE_ST_MAP while the channel lives, i.e. the 2.9 marks. */
+bool
+nvkmd_nvrm_fence_chan_rebind(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (ctx->slot1 == 0)
+      return true;
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[ctx->slot1 - 1];
+   const uintptr_t errVA =
+      (uintptr_t)&((NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   const uint32_t handle = s->ctx == ctx ? s->kchan : 0;
+   const unsigned errBase = s->errBase;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (handle == 0)
+      return true;
+   struct NVRMFenceReq r;
+   nvrm_fence_req(&r, NVRM_FENCE_OP_CHAN_REBIND, 0);
+   r.u.chan.errVA = errVA;
+   r.u.chan.errBase = errBase;
+   r.u.chan.chan = handle;
+   const bool placed = nvrm_fence_notifier_ok(errVA);
+   const bool ok = placed && nvrm_fence_call(&r) && r.status == NVRM_FENCE_ST_OK;
+   uint32_t gone = 0;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   if (s->ctx == ctx && s->kchan == handle) {
+      if (ok)
+         s->kseqQuiet = 0;   /* the kernel forgot the old fault: it may sleep on this channel again */
+      else
+         gone = nvrm_fence_chan_take(s);
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (ok)
+      return true;
+   nvrm_fence_chan_del(gone);
+   nvrm_fence_say("the kernel would not follow a rebuilt channel's new error notifier", placed ? r.status : 0);
+   return false;
+}
