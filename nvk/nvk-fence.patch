+/* True when the process has a registered channel and the kernel watches every one: the condition for OPEN. */
+static bool
+nvrm_fence_all_watched(void)
+{
+   unsigned live = 0;
+   bool all = true;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned i = 0; i < NVRM_CTX_MAX; i++) {
+      if (nvkmd_nvrm_slots[i].ctx == NULL)
+         continue;
+      live++;
+      all = all && nvkmd_nvrm_slots[i].kchan != 0;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return live != 0 && all;
+}
