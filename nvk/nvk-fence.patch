+/* The plugin's requests (nvmtl_nvk_fence_v1, nvkmd.h). Only QUERY, OPEN, ARM, CLOSE and WAIT are accepted: the channel
+ * ops are NVK's own. Each request is built from nvrm_fence_abi.h alone, every field it does not use zero, and the
+ * kernel's output is read only after NVRM_FENCE_ST_OK. No NVK lock is held while the kernel answers (a WAIT may sleep
+ * up to NVRM_FENCE_WAIT_MAX_MS). */
+uint32_t
+nvkmd_nvrm_fence(struct nvkmd_dev *dev, uint32_t op, uint32_t flags, uint64_t cookie, uint32_t count,
+                 const uint32_t *ids, const uint8_t *planes, struct vk_sync *sync, uint32_t pid,
+                 uint32_t timeout_ms, uint32_t out[6])
+{
+   (void)dev;   /* every request of the process goes through its one fence connection */
+   if (out != NULL)
+      memset(out, 0, 6 * sizeof(out[0]));
+   if (op != NVRM_FENCE_OP_QUERY && __atomic_load_n(&nvrm_fence_have, __ATOMIC_ACQUIRE) < 0)
+      return NVRM_FENCE_ST_OFF;
+   struct NVRMFenceReq r;
+   switch (op) {
+   case NVRM_FENCE_OP_QUERY:
+      nvrm_fence_req(&r, op, 0);
+      if (nvrm_fence_call(&r) && r.status == NVRM_FENCE_ST_OK && out != NULL) {
+         /* without asynchronous submission no channel is registered, so this process can take no hold */
+         out[0] = r.u.query.active && nvkmd_nvrm_async_on() ? 1 : 0;
+         out[1] = r.u.query.accel;
+         out[2] = r.u.query.capGpuMs;
+         out[3] = r.u.query.capCpuMs;
+         out[4] = r.u.query.state;
+      }
+      return r.status;
+   case NVRM_FENCE_OP_OPEN:
+   case NVRM_FENCE_OP_ARM:
+   case NVRM_FENCE_OP_CLOSE: {
+      if (count > NVRM_FENCE_MAX_IDS || (count == 0 && op != NVRM_FENCE_OP_CLOSE) || (count != 0 && ids == NULL))
+         return NVRM_FENCE_ST_BAD_ARG;
+      uint32_t armFlags = 0, handle = 0;
+      uint64_t seq = 0;
+      if (op == NVRM_FENCE_OP_OPEN && !nvrm_fence_all_watched())
+         return NVRM_FENCE_ST_MAP;   /* a channel the kernel does not watch: this process keeps the 2.9 marks */
+      if (op == NVRM_FENCE_OP_ARM) {
+         /* the fence's one pending submission and its channel's handle, or already complete; anything else is not
+          * armed, and the hold ends at its CLOSE (the 2.9 timing) */
+         int k = -1;
+         if (sync != NULL && nvkmd_nvrm_async_on()) {
+            uint32_t slot = 0, gen = 0;
+            pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+            k = nvkmd_nvrm_sync_fence_target(sync, &slot, &gen, &seq);
+            if (k == 1) {
+               const struct nvkmd_nvrm_slot *s = slot < NVRM_CTX_MAX ? &nvkmd_nvrm_slots[slot] : NULL;
+               handle = s != NULL && s->ctx != NULL && s->gen == gen ? s->kchan : 0;
+               if (handle == 0)
+                  k = -1;
+            }
+            pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+         }
+         if (k < 0)
+            return NVRM_FENCE_ST_STALE;
+         if (k == 0) {
+            armFlags = NVRM_FENCE_F_ARM_DONE;
+            seq = 0;
+         }
+      }
+      nvrm_fence_req(&r, op, op == NVRM_FENCE_OP_OPEN ? flags & (NVRM_FENCE_F_COMPOSITOR | NVRM_FENCE_F_AUTO) : armFlags);
+      r.u.hold.cookie = cookie;
+      r.u.hold.count = count;
+      for (uint32_t i = 0; i < count; i++) {
+         r.u.hold.ids[i] = ids[i];
+         if (op == NVRM_FENCE_OP_OPEN && planes != NULL)
+            r.u.hold.planes[i] = planes[i];
+      }
+      if (op == NVRM_FENCE_OP_ARM) {
+         r.u.hold.chan = handle;
+         r.u.hold.seq = seq;
+      }
+      (void)nvrm_fence_call(&r);
+      return r.status;
+   }
+   case NVRM_FENCE_OP_WAIT:
+      if (ids == NULL)
+         return NVRM_FENCE_ST_BAD_ARG;
+      nvrm_fence_req(&r, op, flags & (NVRM_FENCE_F_COMPOSITOR | NVRM_FENCE_F_LOOK));
+      r.u.wait.id = ids[0];
+      r.u.wait.planes = planes != NULL ? planes[0] : 0;
+      r.u.wait.pid = pid;
+      r.u.wait.timeoutMs = timeout_ms;
+      if (nvrm_fence_call(&r) && r.status == NVRM_FENCE_ST_OK && out != NULL) {
+         out[0] = r.u.wait.result;
+         out[1] = r.u.wait.waitedUs > UINT32_MAX ? UINT32_MAX : (uint32_t)r.u.wait.waitedUs;
+         out[2] = r.u.wait.ownerPid;
+         out[3] = r.u.wait.state;
+         out[4] = r.u.wait.blockers;
+      }
+      return r.status;
+   default:
+      return NVRM_FENCE_ST_BAD_ARG;
+   }
+}
