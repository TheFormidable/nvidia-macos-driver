 }
+/* The boost policy (nvrm_boost_policy_abi.h): one call through selector 13, two scalars in, one out. A kext without
+ * the selector answers kIOReturnBadArgument (past the end of its table); a set from a process that is not root,
+ * kIOReturnNotPrivileged. */
+int nvrm_xnu_boost_policy(int fd, uint32_t op, uint32_t value, uint64_t *policy)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return -1;
+    uint64_t in[2] = { op, value }, o = 0; uint32_t n = 1;
+    kern_return_t kr = IOConnectCallScalarMethod(conn, NVRM_BOOST_POLICY_SELECTOR, in, 2, &o, &n);
+    if (kr == kIOReturnBadArgument && op == NVRM_BP_OP_READ) return NVRM_XNU_NO_METHOD;
+    if (kr == kIOReturnUnsupported) return NVRM_XNU_NO_METHOD;
+    if (kr == kIOReturnNotPrivileged || kr == kIOReturnBadArgument) return NVRM_XNU_REFUSED;
+    if (kr != KERN_SUCCESS || n != 1) return -1;
+    *policy = o;
+    return 0;
+}
