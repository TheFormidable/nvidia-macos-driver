Fixes in NVK's NVRM back end and in two readers of nvrm610.conf. NullMoth's own change (not an upstream Mesa commit).
The table of CPU mappings had no lock. Each CPU map of a memory object adds its address to the device's table
(dev->mappings) and each unmap looks it up and removes it. nvkmd.c serialises the maps of one memory object only
(map_mutex), and client maps and the unmaps of nvkmd_mem_unref not at all, so two threads mapping or freeing two
different memories changed the hash table at the same time and could corrupt the heap. Every insert, search and
remove now holds a mutex of the device (mappings_mutex), created and destroyed with the table. It is held only around
the table operation, never across an RM call and never while another lock is taken, so it cannot be part of a lock
cycle. An unmap now removes its entry before the RM unmap instead of after it: once RM has unmapped, another thread
can be given the same address and insert it, and the old order then removed that new mapping's entry.
VK_EXT_map_memory_placed is no longer offered on the NVRM back end. The NVRM map ignores the address the application
asks for (only the host-pointer import looks at it, to refuse it) and its overmap, which a reserved unmap needs, only
returns an error; Zink turns on client-pointer maps when it sees the extension with memoryMapPlaced and
memoryUnmapReserve. The extension is now offered where the back end has has_map_fixed and has_overmap: the nouveau
back end sets both, so it keeps it unchanged.
NVRM_FLUSH_TIMEOUT_MS was read on every synchronous flush (NVRM_ASYNC=0, or a channel with no submission slot), and
NVK_SYSMEM_GPU_UNCACHED and NVK_BAR_VRAM on every vkAllocateMemory: a getenv and, with the variable unset, a scan of
nvrm610.conf that writes a line to stderr each time the file sets the name. Each is now read once for the process with
util_call_once, which also makes the read safe from two threads (nvmtl_cfg_getenv's static buffers are not). The
values mean what they meant: NVRM_FLUSH_TIMEOUT_MS is atol of the value or 5000, NVK_SYSMEM_GPU_UNCACHED=1 keeps app
memory volatile, NVK_BAR_VRAM=0 keeps host-visible device-local memory out of BAR1.
A failure to create the mapping table closed the process's standard input: CALLOC left osEvent at 0 and the destroy
path closes it when it is not negative. osEvent is now -1 before the first way out.

diff --git a/src/nouveau/vulkan/nvk_device_memory.c b/src/nouveau/vulkan/nvk_device_memory.c
index f87935f..b6aa5a5 100644
--- a/src/nouveau/vulkan/nvk_device_memory.c
+++ b/src/nouveau/vulkan/nvk_device_memory.c
@@ -13,6 +13,7 @@
 #include "vk_fence.h"
 
 #include "util/u_atomic.h"
+#include "util/u_call_once.h"
 
 #include <inttypes.h>
 #include <sys/mman.h>
@@ -54,6 +55,41 @@ const VkExternalMemoryProperties nvk_host_mem_props = {
    .compatibleHandleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
 };
 
+/* NVK_SYSMEM_GPU_UNCACHED=1 and NVK_BAR_VRAM=0, each read once for the process on its first use. They were read on
+ * every vkAllocateMemory: a getenv, and with the variable unset a scan of nvrm610.conf and, when the file sets it, a
+ * line on stderr each time; nvmtl_cfg_getenv's buffers are also not safe for two allocating threads. */
+static bool nvk_sysmem_gpu_uncached_value, nvk_bar_vram_off_value;
+static util_once_flag nvk_sysmem_gpu_uncached_once = UTIL_ONCE_FLAG_INIT;
+static util_once_flag nvk_bar_vram_off_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+nvk_sysmem_gpu_uncached_read(void)
+{
+   const char *e = nvmtl_cfg_getenv("NVK_SYSMEM_GPU_UNCACHED");
+   nvk_sysmem_gpu_uncached_value = e && e[0] == '1';
+}
+
+static void
+nvk_bar_vram_off_read(void)
+{
+   const char *e = nvmtl_cfg_getenv("NVK_BAR_VRAM");
+   nvk_bar_vram_off_value = e && e[0] == '0';
+}
+
+static bool
+nvk_sysmem_gpu_uncached(void)
+{
+   util_call_once(&nvk_sysmem_gpu_uncached_once, nvk_sysmem_gpu_uncached_read);
+   return nvk_sysmem_gpu_uncached_value;
+}
+
+static bool
+nvk_bar_vram_off(void)
+{
+   util_call_once(&nvk_bar_vram_off_once, nvk_bar_vram_off_read);
+   return nvk_bar_vram_off_value;
+}
+
 static enum nvkmd_mem_flags
 nvk_memory_type_flags(const VkMemoryType *type,
                       VkExternalMemoryHandleTypeFlagBits handle_types,
@@ -80,20 +116,14 @@ nvk_memory_type_flags(const VkMemoryType *type,
     * every submission with the write-back + clean-line invalidate that keeps it coherent. Exported or
     * imported memory stays volatile: another process or device reaches it outside our submissions.
     * NVK_SYSMEM_GPU_UNCACHED=1 restores the volatile mapping everywhere (the speed control). */
-   else {
-      const char *e = nvmtl_cfg_getenv("NVK_SYSMEM_GPU_UNCACHED");
-      if (!(e && e[0] == '1'))
-         flags |= NVK69_MEM_GPU_CACHED;
-   }
+   else if (!nvk_sysmem_gpu_uncached())
+      flags |= NVK69_MEM_GPU_CACHED;
 
    /* NVMTL batch 36: an app's DEVICE_LOCAL|HOST_VISIBLE memory really lives in VRAM, mapped through
     * BAR1. Exported/imported memory keeps the old GART placement. NVK_BAR_VRAM=0 restores it everywhere. */
    if ((type->propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
-       (type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && handle_types == 0) {
-      const char *e = nvmtl_cfg_getenv("NVK_BAR_VRAM");
-      if (!(e && e[0] == '0'))
-         flags |= NVKMD_MEM_BAR;
-   }
+       (type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && handle_types == 0 && !nvk_bar_vram_off())
+      flags |= NVKMD_MEM_BAR;
 
    return flags;
 }
