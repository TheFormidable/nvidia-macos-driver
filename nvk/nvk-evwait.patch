+ * timeout_us (0 = just read the count). *out is the kext's whole answer: the count in bits 0..31 and, from a kext that
+ * reports it, why the call returned in bits 32..39 (nvrm_evwait.h; 0 from an older kext, which only zero-extends its
+ * 32-bit count). Returns 0 when the kext answered, -1 when there is no connection or the call failed (pre-b73). */
+int nvrm_xnu_wait_event2(int fd, uint32_t seen, uint32_t timeout_us, uint64_t *out)
 {
     io_connect_t conn = conn_of(fd); if (!conn) return -1;
-    uint64_t in[2] = { seen, timeout_us }, out = 0; uint32_t n = 1;
-    kern_return_t kr = IOConnectCallScalarMethod(conn, 6, in, 2, &out, &n);
-    return kr == KERN_SUCCESS ? (int64_t)(uint32_t)out : -1;
+    uint64_t in[2] = { seen, timeout_us }, o = 0; uint32_t n = 1;
+    kern_return_t kr = IOConnectCallScalarMethod(conn, NVRM_EVW_SEL_WAIT, in, 2, &o, &n);
+    if (kr != KERN_SUCCESS) return -1;
+    *out = o;
+    return 0;
+}
+/* The count alone, or -1 when the kext has no selector 6: the 2.9 call, kept for the synchronous flush's sleep. */
+int64_t nvrm_xnu_wait_event(int fd, uint32_t seen, uint32_t timeout_us)
+{
+    uint64_t out = 0;
+    return nvrm_xnu_wait_event2(fd, seen, timeout_us, &out) == 0 ? (int64_t)nvrm_evw_seq(out) : -1;
+}
+/* Tell the kext what this process observed about its event wakes (NVRM_EVW_NOTE_*, selector 9), so that one sysctl
+ * shows it for the whole machine. Only counted there; a kext without selector 9 refuses it and nothing else happens. */
+void nvrm_xnu_evt_note(int fd, unsigned what)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return;
+    uint64_t in = what;
+    (void)IOConnectCallScalarMethod(conn, NVRM_EVW_SEL_NOTE, &in, 1, NULL, NULL);
